---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="On Hiatus | The Hidden Lodge"
	description="The Hidden Lodge raider features are currently offline. We'll return for Season 2."
>
	<div class="hiatus-wrap">
		<div class="card hiatus-card">
			<p class="hiatus-label">Guild Hiatus</p>
			<h1>See You in Season 2</h1>
			<p class="hiatus-body">
				The Hidden Lodge is taking a well-earned break between seasons. Raider tools, signups,
				and member features are offline until we return for Season 2.
			</p>
			<p class="hiatus-body">
				In the meantime, check out our roster, lore, and guild info — and keep an eye on our
				articles for updates.
			</p>
			<div class="hiatus-links">
				<a class="btn btn--secondary" href="/">Home</a>
				<a class="btn btn--secondary" href="/roster">Roster</a>
				<a class="btn btn--secondary" href="/articles">Articles</a>
			</div>
		</div>
	</div>
</Layout>

<style>
	.hiatus-wrap {
		display: flex;
		justify-content: center;
		align-items: center;
		min-height: 50vh;
	}

	.hiatus-card {
		max-width: 38rem;
		width: 100%;
		text-align: center;
		padding: var(--space-8) var(--space-7);
		backdrop-filter: blur(6px);
	}

	.hiatus-label {
		margin: 0 0 var(--space-5);
		font-size: var(--text-sm);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--gold);
		opacity: 0.8;
	}

	h1 {
		margin: 0 0 var(--space-7);
		color: var(--gold-bright);
		text-shadow: 0 0 24px rgb(var(--gold-rgb) / 0.22);
	}

	.hiatus-body {
		margin: 0 0 var(--space-6);
		color: var(--muted);
		font-size: var(--text-lg);
		line-height: var(--leading-loose);
	}

	.hiatus-links {
		display: flex;
		justify-content: center;
		gap: var(--space-5);
		flex-wrap: wrap;
		margin-top: var(--space-7);
	}
</style>
