---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import {
  DEATH_ANALYSIS_RAID_NAME,
  DEATH_ANALYSIS_RECENCY_HALF_LIFE_DAYS,
  DEATH_ANALYSIS_WINDOW_DAYS,
  getDeathAnalysisSummary,
  raidWindowForNight,
} from '../lib/death-analysis';
import { classColor } from '../lib/wow';
import { FEATURE_FLAGS } from '../lib/feature-flags';

if (!FEATURE_FLAGS.tools || !FEATURE_FLAGS.deathAnalysis) {
  return Astro.redirect('/');
}

const isGuildMember = Astro.locals.isGuildMember;
if (!isGuildMember) {
  return Astro.redirect('/auth/login');
}

const review = await getDeathAnalysisSummary();
const dateFormatter = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', month: 'short', day: 'numeric', year: 'numeric' });
const nightFormatter = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', weekday: 'short', month: 'short', day: 'numeric' });
const startLabel = dateFormatter.format(new Date(review.cutoffUtc * 1000));
const lastSyncedLabel = review.lastSyncedAt ? new Date(review.lastSyncedAt * 1000).toLocaleString('en-US', { timeZone: 'America/New_York' }) + ' ET' : 'Not synced yet';
const includedNights = review.nights.filter((night) => night.canonical && night.canonical.bossPulls > 0);
function nightLabel(nightKey: string): string {
  const window = raidWindowForNight(nightKey);
  return window ? nightFormatter.format(new Date(window.startUtc * 1000)) : nightKey;
}
const deathOrdinals = ['1st', '2nd', '3rd', '4th'];
function deathOrdinal(position: number): string {
  return deathOrdinals[position - 1] ?? `${position}th`;
}
function formatDeathOffset(ms: number): string {
  const totalSeconds = Math.max(0, Math.round(ms / 1000));
  const minutes = Math.floor(totalSeconds / 60);
  const seconds = totalSeconds % 60;
  return `${minutes}:${String(seconds).padStart(2, '0')}`;
}
const guildRankingsUrl = 'https://www.warcraftlogs.com/guild/rankings/781707/latest?difficulty=4&playerdisplay=median&recent=true';
---

<Layout title="Death Analysis | The Hidden Lodge">
  <div class="death-analysis-page">
    <div class="page-header">
      <div>
        <h1>Death Analysis</h1>
        <div class="scope-badges" aria-label="Current review scope">
          <span class="scope-badge">Season: Midnight S2</span>
          <span class="scope-badge">Raid: {DEATH_ANALYSIS_RAID_NAME} (Heroic/Mythic)</span>
          <span class="scope-badge">Thu/Fri 9pm–midnight ET</span>
          <span class="scope-badge">Last {DEATH_ANALYSIS_WINDOW_DAYS} days</span>
          <span class="scope-badge">Recent logs weighted more</span>
        </div>
        <p class="page-desc">
          Tracks excessive deaths on our Thursday and Friday raid nights by weighting early deaths in each Heroic or Mythic {DEATH_ANALYSIS_RAID_NAME} boss pull. When several people log the same night, only one report counts.
        </p>
      </div>
      <div class="header-actions">
        <a href={guildRankingsUrl} target="_blank" rel="noopener noreferrer" class="rankings-cta">
          View WCL Guild Rankings
        </a>
      </div>
    </div>

    <section class="overview-grid" aria-label="Death analysis summary">
      <article class="overview-card">
        <span class="overview-label">Tracked Window</span>
        <strong>{startLabel} to today</strong>
        <p>{review.includedNights} raid night{review.includedNights === 1 ? '' : 's'} and {review.includedPulls.toLocaleString()} boss pulls counted.</p>
      </article>
      <article class="overview-card">
        <span class="overview-label">Qualified Raiders</span>
        <strong>{review.qualifiedPlayers.toLocaleString()}</strong>
        <p>Minimum sample: {review.minimumPulls} boss pulls across {review.minimumReports}+ reports. Average weighted score: {review.averageWeightedScore !== null ? review.averageWeightedScore.toFixed(2) : '—'}.</p>
      </article>
      <article class="overview-card">
        <span class="overview-label">Last Sync</span>
        <strong>{lastSyncedLabel}</strong>
        <p>New logs are picked up automatically, usually within a few hours of upload.</p>
      </article>
    </section>

    <section class="content-section formula-card">
      <div class="section-heading-row">
        <div>
          <h2><Icon name="lucide:skull" aria-hidden="true" />Excessive Deaths</h2>
          <p class="section-copy">
            Score is weighted by actual boss pulls attended, not only pulls where someone died.
          </p>
        </div>
      </div>
      <div class="formula-grid">
        <div>
          <span class="formula-label">Weighted score</span>
          <p><strong>Recency-weighted (4 × first + 3 × second + 2 × third + 1 × fourth) / recency-weighted pulls</strong></p>
        </div>
        <div>
          <span class="formula-label">Death rate</span>
          <p><strong>Recency-weighted counted deaths / recency-weighted pulls</strong></p>
        </div>
        <div>
          <span class="formula-label">Recent-log weighting</span>
          <p>Each report’s weight halves every {DEATH_ANALYSIS_RECENCY_HALF_LIFE_DAYS} days: <strong>100%</strong> today, <strong>50%</strong> at {DEATH_ANALYSIS_RECENCY_HALF_LIFE_DAYS} days, and <strong>25%</strong> at {DEATH_ANALYSIS_WINDOW_DAYS} days. This lets sustained improvements surface sooner while every report in the window still counts.</p>
        </div>
        <div>
          <span class="formula-label">Filter</span>
          <p><strong>{review.minimumPulls}+</strong> pulls across <strong>{review.minimumReports}+</strong> reports required before a raider is ranked.</p>
        </div>
        <div>
          <span class="formula-label">Death cap rule</span>
          <p><strong>Only the first 4 deaths per pull are counted.</strong> Deaths after the fourth in the same pull are ignored.</p>
        </div>
      </div>
    </section>

    <section class="content-section">
      <div class="section-heading-row">
        <div>
          <h2>All Raider Rankings</h2>
          <p class="section-copy">
            Raiders with {review.minimumPulls}+ boss pulls across {review.minimumReports}+ reports, sorted by weighted excessive-death score, then first-death count. Raiders more than 25% above the average are highlighted.
          </p>
        </div>
      </div>

      {review.rankings.length === 0 ? (
        <p class="empty-state">No raiders have {review.minimumPulls}+ {DEATH_ANALYSIS_RAID_NAME} boss pulls across {review.minimumReports}+ reports yet. Check back after the next sync.</p>
      ) : (
        <div class="table-wrap">
          <table class="review-table review-table-full sortable-table">
            <thead>
              <tr>
                <th><button type="button" class="sort-btn" data-col-index="0" data-sort-type="text">Raider</button></th>
                <th><button type="button" class="sort-btn" data-col-index="1" data-sort-type="number">Reports</button></th>
                <th><button type="button" class="sort-btn" data-col-index="2" data-sort-type="number">Pulls</button></th>
                <th><button type="button" class="sort-btn" data-col-index="3" data-sort-type="number">Deaths (capped)</button></th>
                <th><button type="button" class="sort-btn" data-col-index="4" data-sort-type="number">Death Rate</button></th>
                <th><button type="button" class="sort-btn" data-col-index="5" data-sort-type="number">1st</button></th>
                <th><button type="button" class="sort-btn" data-col-index="6" data-sort-type="number">2nd</button></th>
                <th><button type="button" class="sort-btn" data-col-index="7" data-sort-type="number">3rd</button></th>
                <th><button type="button" class="sort-btn" data-col-index="8" data-sort-type="number">4th</button></th>
                <th><button type="button" class="sort-btn" data-col-index="9" data-sort-type="number">Weighted Score</button></th>
              </tr>
            </thead>
            <tbody>
              {review.rankings.map((row) => (
                <>
                  <tr
                    class:list={{ flagged: row.isSignificantlyAboveAverage }}
                    data-detail-target={row.deathLinks.length > 0 ? `death-links-${row.blizzardCharId}` : undefined}
                  >
                    <td data-sort-value={`${row.name.toLowerCase()} ${row.realm.toLowerCase()}`}>
                      <div class="raider-cell">
                        <strong style={`color: ${classColor(row.className)}`}>{row.name}</strong>
                        <span>{row.realm}</span>
                      </div>
                      {row.deathLinks.length > 0 && (
                        <button
                          type="button"
                          class="death-links-toggle"
                          aria-expanded="false"
                          aria-controls={`death-links-${row.blizzardCharId}`}
                        >
                          {row.deathLinks.length} death{row.deathLinks.length === 1 ? '' : 's'} logged
                        </button>
                      )}
                    </td>
                    <td data-sort-value={String(row.reportCount)}>{row.reportCount.toLocaleString()}</td>
                    <td data-sort-value={String(row.fightsPresent)}>{row.fightsPresent.toLocaleString()}</td>
                    <td data-sort-value={String(row.totalDeaths)}>{row.totalDeaths.toLocaleString()}</td>
                    <td data-sort-value={row.totalDeathRate.toFixed(6)}>{(row.totalDeathRate * 100).toFixed(1)}%</td>
                    <td data-sort-value={String(row.firstDeathCount)}>{row.firstDeathCount.toLocaleString()}</td>
                    <td data-sort-value={String(row.secondDeathCount)}>{row.secondDeathCount.toLocaleString()}</td>
                    <td data-sort-value={String(row.thirdDeathCount)}>{row.thirdDeathCount.toLocaleString()}</td>
                    <td data-sort-value={String(row.fourthDeathCount)}>{row.fourthDeathCount.toLocaleString()}</td>
                    <td data-sort-value={row.weightedScore.toFixed(6)}>
                      <span class="score-cell">{row.weightedScore.toFixed(2)}</span>
                      {row.percentAboveAverage !== null && row.percentAboveAverage > 0 && (
                        <small>{row.percentAboveAverage.toFixed(1)}% above avg</small>
                      )}
                    </td>
                  </tr>
                  {row.deathLinks.length > 0 && (
                    <tr id={`death-links-${row.blizzardCharId}`} class="death-links-row" hidden>
                      <td colspan={10}>
                        <div class="death-links-panel">
                          <table class="death-links-table">
                            <thead>
                              <tr>
                                <th>Death</th>
                                <th>Defensives available</th>
                                <th>Healthstone / Potion</th>
                              </tr>
                            </thead>
                            <tbody>
                              {row.deathLinks.map((link) => (
                                <tr
                                  class="death-cooldown-row"
                                  data-report-code={link.reportCode}
                                  data-fight-id={link.fightId}
                                  data-death-position={link.deathPosition}
                                  data-death-offset-ms={link.deathOffsetMs}
                                  data-blizzard-char-id={row.blizzardCharId}
                                >
                                  <td>
                                    <a
                                      href={`https://www.warcraftlogs.com/reports/${link.reportCode}#fight=${link.fightId}&type=deaths&death=${link.deathPosition}`}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      class="report-link"
                                    >
                                      {link.nightKey ? nightLabel(link.nightKey) : link.reportCode}{link.encounterName ? ` · ${link.encounterName}` : ''}
                                    </a>
                                    <span>{deathOrdinal(link.deathPosition)} death &middot; {formatDeathOffset(link.deathOffsetMs)} into pull</span>
                                  </td>
                                  <td class="death-cooldown-defensives">—</td>
                                  <td class="death-cooldown-consumables">—</td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                          <p class="death-cooldown-note">Defensive/consumable availability is estimated from cast history and may not reflect talent or gear cooldown reductions.</p>
                        </div>
                      </td>
                    </tr>
                  )}
                </>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    {includedNights.length > 0 && (
      <section class="content-section">
        <div class="section-heading-row">
          <div>
            <h2><Icon name="lucide:file-search" aria-hidden="true" />Included Raid Nights</h2>
            <p class="section-copy">The one report counted for each raid night.</p>
          </div>
        </div>
        <div class="table-wrap">
          <table class="review-table nights-table">
            <thead>
              <tr>
                <th>Night</th>
                <th>WCL Report</th>
                <th>Pulls</th>
                <th>Kills</th>
              </tr>
            </thead>
            <tbody>
              {includedNights.map((night) => (
                <tr>
                  <td>{nightLabel(night.nightKey)}</td>
                  <td>
                    <a href={`https://www.warcraftlogs.com/reports/${night.canonical!.code}`} target="_blank" rel="noopener noreferrer" class="report-link">{night.canonical!.code}</a>
                  </td>
                  <td>{night.canonical!.bossPulls}</td>
                  <td>{night.canonical!.bossKills}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}
  </div>
</Layout>

<script is:inline>
  window.whTooltips = {
    colorLinks: true,
    iconizeLinks: false,
    renameLinks: false,
  };
</script>
<script is:inline src="https://wow.zamimg.com/js/tooltips.js"></script>

<script>
  // @ts-nocheck
  (() => {
    const sortableTables = document.querySelectorAll('.sortable-table');

    /**
     * @param {Element | null} cell
     * @param {'number' | 'text'} sortType
     */
    const readCellSortValue = (cell, sortType) => {
      const raw = (cell?.getAttribute('data-sort-value') ?? cell?.textContent ?? '').trim();
      if (sortType === 'number') {
        const parsed = Number.parseFloat(raw);
        return Number.isFinite(parsed) ? parsed : Number.NEGATIVE_INFINITY;
      }
      return raw.toLowerCase();
    };

    for (const table of sortableTables) {
      const tbody = table.querySelector('tbody');
      const buttons = table.querySelectorAll('thead .sort-btn');
      if (!tbody || buttons.length === 0) continue;

      for (const button of buttons) {
        button.addEventListener('click', () => {
          const colIndex = Number.parseInt(button.getAttribute('data-col-index') ?? '-1', 10);
          if (!Number.isInteger(colIndex) || colIndex < 0) return;

          /** @type {'number' | 'text'} */
          const sortType = (button.getAttribute('data-sort-type') ?? 'text').toLowerCase() === 'number'
            ? 'number'
            : 'text';
          const currentDir = button.getAttribute('data-sort-dir') === 'asc' ? 'asc' : 'desc';
          const nextDir = currentDir === 'asc' ? 'desc' : 'asc';

          for (const other of buttons) {
            other.removeAttribute('data-sort-dir');
          }
          button.setAttribute('data-sort-dir', nextDir);

          // Only direct-child rows of this tbody: querySelectorAll('tr') would
          // also reach into the nested death-links-table's own <tr>s (inside a
          // detail row's <td>) and reparent them here, corrupting that table.
          // Detail rows are separate full-width <tr>s linked to their raider
          // row via data-detail-target/id, not nested inside it, so they must
          // be excluded from sorting and re-paired with their raider row after.
          const rows = Array.from(tbody.children).filter(
            (row) => row.tagName === 'TR' && !row.classList.contains('death-links-row')
          );
          rows.sort((leftRow, rightRow) => {
            const leftCell = leftRow.children.item(colIndex);
            const rightCell = rightRow.children.item(colIndex);
            const leftValue = readCellSortValue(leftCell, sortType);
            const rightValue = readCellSortValue(rightCell, sortType);

            let result = 0;
            if (sortType === 'number') {
              result = leftValue - rightValue;
            } else {
              result = String(leftValue).localeCompare(String(rightValue));
            }

            if (result === 0) {
              const leftFallback = (leftRow.children.item(0)?.getAttribute('data-sort-value') ?? '').toLowerCase();
              const rightFallback = (rightRow.children.item(0)?.getAttribute('data-sort-value') ?? '').toLowerCase();
              result = leftFallback.localeCompare(rightFallback);
            }

            return nextDir === 'asc' ? result : -result;
          });

          for (const row of rows) {
            tbody.appendChild(row);
            const detailId = row.getAttribute('data-detail-target');
            const detailRow = detailId ? document.getElementById(detailId) : null;
            if (detailRow) tbody.appendChild(detailRow);
          }
        });
      }
    }
  })();

  // @ts-nocheck
  (() => {
    const loadedDetails = new WeakSet();

    const STATUS_LABELS = { available: 'Available', on_cooldown: 'On CD', unknown: 'Unknown', not_tracked: 'Not tracked' };

    /** @param {{status: string, secondsRemaining: number|null}} ability */
    const statusText = (ability) => {
      const label = STATUS_LABELS[ability.status] ?? 'Unknown';
      return ability.status === 'on_cooldown' && ability.secondsRemaining ? `${label} (~${ability.secondsRemaining}s)` : label;
    };

    /** @param {{abilityId: number, name: string, status: string, secondsRemaining: number|null, iconUrl: string|null}} ability */
    const buildChip = (ability) => {
      // Wowhead's tooltip script (loaded below) only scans <a> tags for
      // data-wowhead, same convention as the item links on /upgrades and
      // /raiders/gear-summary — a plain <span> is silently ignored.
      const chip = document.createElement(ability.abilityId > 0 ? 'a' : 'span');
      chip.className = `cd-chip cd-chip-${ability.status}`;
      if (ability.abilityId > 0) {
        chip.href = `https://www.wowhead.com/spell=${ability.abilityId}`;
        chip.target = '_blank';
        chip.rel = 'noopener noreferrer';
        chip.setAttribute('data-wowhead', `spell=${ability.abilityId}`);
      }
      if (ability.iconUrl) {
        const img = document.createElement('img');
        img.src = ability.iconUrl;
        img.alt = '';
        img.loading = 'lazy';
        img.className = 'cd-chip-icon';
        chip.appendChild(img);
      }
      const label = document.createElement('span');
      label.className = 'cd-chip-label';
      label.textContent = `${ability.name} · ${statusText(ability)}`;
      chip.appendChild(label);
      // Native title as a fallback for when the Wowhead tooltip script is blocked.
      chip.title = `${ability.name}: ${statusText(ability)}`;
      return chip;
    };

    /** @param {Element} container @param {Array<object>} abilities @param {string} emptyText */
    const renderChips = (container, abilities, emptyText) => {
      container.textContent = '';
      if (abilities.length === 0) {
        const empty = document.createElement('span');
        empty.className = 'cd-empty';
        empty.textContent = emptyText;
        container.appendChild(empty);
        return;
      }
      const wrap = document.createElement('div');
      wrap.className = 'cd-chip-row';
      for (const ability of abilities) wrap.appendChild(buildChip(ability));
      container.appendChild(wrap);
    };

    /** @param {HTMLTableRowElement} row */
    const loadCooldownRow = async (row) => {
      const defensivesCell = row.querySelector('.death-cooldown-defensives');
      const consumablesCell = row.querySelector('.death-cooldown-consumables');
      if (!defensivesCell || !consumablesCell) return;

      defensivesCell.textContent = 'Loading…';
      consumablesCell.textContent = 'Loading…';

      const params = new URLSearchParams({
        reportCode: row.getAttribute('data-report-code') ?? '',
        fightId: row.getAttribute('data-fight-id') ?? '',
        deathPosition: row.getAttribute('data-death-position') ?? '',
        deathOffsetMs: row.getAttribute('data-death-offset-ms') ?? '',
        blizzardCharId: row.getAttribute('data-blizzard-char-id') ?? '',
      });

      try {
        const response = await fetch(`/api/death-analysis/death-cooldowns?${params.toString()}`);
        if (!response.ok) throw new Error('request failed');
        const payload = await response.json();
        const detail = payload?.data;
        if (!detail) throw new Error('no data');

        renderChips(defensivesCell, detail.defensives, 'No defensives tracked for this spec');
        renderChips(consumablesCell, detail.consumables, 'No consumables tracked');
        // Chips are inserted after tooltips.js's initial DOM scan, so it needs
        // to be told about the new data-wowhead elements explicitly.
        window.$WowheadPower?.refreshLinks();
      } catch {
        defensivesCell.textContent = 'Failed to load';
        consumablesCell.textContent = 'Failed to load';
      }
    };

    document.querySelectorAll('.death-links-toggle').forEach((button) => {
      button.addEventListener('click', () => {
        const targetId = button.getAttribute('aria-controls');
        const detailRow = targetId ? document.getElementById(targetId) : null;
        if (!detailRow) return;

        const nowHidden = !detailRow.hidden;
        detailRow.hidden = nowHidden;
        button.setAttribute('aria-expanded', String(!nowHidden));

        if (nowHidden || loadedDetails.has(detailRow)) return;
        loadedDetails.add(detailRow);
        detailRow.querySelectorAll('.death-cooldown-row').forEach((row) => loadCooldownRow(row));
      });
    });
  })();
</script>

<style>
  .death-analysis-page {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-start;
  }

  .page-desc {
    max-width: 60rem;
    color: var(--muted);
    line-height: 1.6;
    margin: 0.45rem 0 0;
  }

  .scope-badges {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    margin-top: 0.45rem;
  }

  .scope-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.23rem 0.52rem;
    border-radius: 999px;
    border: 1px solid rgba(214, 176, 106, 0.4);
    background: rgba(214, 176, 106, 0.12);
    color: var(--gold-bright);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  .rankings-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    border: 1px solid rgba(244, 194, 92, 0.7);
    border-radius: 0.55rem;
    background: linear-gradient(180deg, rgba(244, 194, 92, 0.24), rgba(214, 176, 106, 0.2));
    color: #ffe7b1;
    padding: 0.5rem 0.95rem;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
    transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .rankings-cta:hover,
  .rankings-cta:focus-visible {
    transform: translateY(-1px);
    border-color: rgba(255, 213, 125, 0.95);
    background: linear-gradient(180deg, rgba(255, 213, 125, 0.28), rgba(224, 186, 112, 0.25));
    text-decoration: none;
  }

  .overview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
  }

  .overview-card,
  .content-section {
    border: 1px solid rgba(214, 176, 106, 0.2);
    border-radius: 0.9rem;
    background: linear-gradient(180deg, rgba(19, 28, 40, 0.92), rgba(10, 17, 26, 0.96));
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.18);
  }

  .overview-card {
    padding: 1rem 1.05rem;
  }

  .overview-card strong {
    display: block;
    color: var(--gold-bright);
    font-size: 1.05rem;
    margin: 0.2rem 0 0.35rem;
  }

  .overview-card p,
  .section-copy {
    margin: 0;
    color: var(--muted);
    line-height: 1.55;
  }

  .overview-label,
  .formula-label {
    display: inline-block;
    color: var(--gold);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .flash {
    padding: 0.8rem 1rem;
    border-radius: 0.75rem;
    border: 1px solid transparent;
  }

  .flash-warn {
    background: rgba(214, 176, 106, 0.1);
    border-color: rgba(214, 176, 106, 0.3);
    color: var(--gold-bright);
  }

  .content-section {
    padding: 1.15rem 1.2rem;
  }

  .section-heading-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-start;
    margin-bottom: 1rem;
