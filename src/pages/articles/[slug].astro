---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const { slug } = Astro.params;

const articles = await getCollection('articles');
const article = articles.find((a) => a.id === slug);

if (!article) {
	// Rewrite rather than redirect so an unknown slug answers 404 instead of a soft-404
	// (a 302 to /articles reads as a live page to crawlers).
	return Astro.rewrite('/404');
}

const { Content } = await render(article);

function formatDate(date: Date) {
	return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout title={`${article.data.title} | The Hidden Lodge`} description={article.data.description}>
	<article class="article-page">
		<header class="article-header">
			<a class="back-link" href="/articles">← Articles</a>
			<div class="article-meta">
				<time datetime={article.data.publishedAt.toISOString()}>
					{formatDate(article.data.publishedAt)}
				</time>
				{article.data.author && (
					<span class="author">by {article.data.author}</span>
				)}
			</div>
			<h1>{article.data.title}</h1>
			<p class="article-description">{article.data.description}</p>
			{article.data.tags.length > 0 && (
				<ul class="tag-list" aria-label="Tags">
					{article.data.tags.map((tag) => (
						<li class="tag">{tag}</li>
					))}
				</ul>
			)}
		</header>

		<div class="article-body">
			<Content />
		</div>
	</article>
</Layout>

<style>
	.article-page {
		max-width: 72ch;
		margin-inline: auto;
		padding-block: 2rem 5rem;
	}

	.back-link {
		display: inline-block;
		color: var(--steel);
		font-size: 0.88rem;
		letter-spacing: 0.04em;
		margin-bottom: 1.5rem;
		text-decoration: none;
		transition: color 0.15s;
	}

	.back-link:hover {
		color: var(--gold);
	}

	.article-header {
		border-bottom: 1px solid var(--border);
		padding-bottom: 1.5rem;
		margin-bottom: 2.5rem;
	}

	.article-meta {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}

	.article-meta time {
		font-size: 0.85rem;
		color: var(--muted);
		letter-spacing: 0.03em;
	}

	.author {
		font-size: 0.85rem;
		color: var(--muted);
	}

	.article-header h1 {
		font-size: 1.9rem;
		color: var(--gold-bright);
		margin: 0 0 0.75rem;
		line-height: 1.25;
	}

	.article-description {
		color: var(--muted);
		font-size: 1.05rem;
		margin: 0 0 1rem;
		line-height: 1.6;
		font-style: italic;
	}

	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.tag {
		background: rgba(140, 167, 187, 0.15);
		border: 1px solid rgba(140, 167, 187, 0.3);
		color: var(--steel);
		font-size: 0.75rem;
		padding: 0.1em 0.55em;
		border-radius: 3px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	/* Article body prose styles */
	.article-body {
		line-height: 1.75;
		font-size: 1rem;
		color: var(--text);
	}

	.article-body :global(h2) {
		font-size: 1.35rem;
		color: var(--gold-bright);
		margin: 1.25rem 0 0.75rem;
		border-bottom: 1px solid rgba(214, 176, 106, 0.2);
		padding-bottom: 0.35rem;
	}

	.article-body :global(h3) {
		font-family: var(--font-body);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
		margin: 1rem 0 0.3rem;
	}

	.article-body :global(p) {
		margin: 0 0 1.2rem;
		color: var(--text);
	}

	.article-body :global(strong) {
		color: var(--gold-bright);
		font-weight: 600;
	}

	.article-body :global(em) {
		color: var(--muted);
	}

	.article-body :global(ul),
	.article-body :global(ol) {
		margin: 0 0 1.2rem 1.5rem;
		padding: 0;
	}

	.article-body :global(li) {
		margin-bottom: 0.4rem;
		color: var(--text);
	}

	.article-body :global(blockquote) {
		border-left: 3px solid var(--gold);
		margin: 1.5rem 0;
		padding: 0.5rem 0 0.5rem 1.25rem;
		color: var(--muted);
		font-style: italic;
	}

	.article-body :global(code) {
		background: rgba(140, 167, 187, 0.12);
		border: 1px solid rgba(140, 167, 187, 0.2);
		border-radius: 3px;
		padding: 0.1em 0.4em;
		font-size: 0.9em;
		color: var(--steel);
	}

	.article-body :global(pre) {
		background: rgba(140, 167, 187, 0.08);
		border: 1px solid rgba(140, 167, 187, 0.2);
		border-radius: 5px;
		padding: 0.75rem 1rem;
		margin: 0 0 1.2rem;
		overflow-x: auto;
		color: var(--text);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.article-body :global(pre code) {
		background: none;
		border: none;
		padding: 0;
		font-size: inherit;
		color: inherit;
	}

	.article-body :global(hr) {
		display: none;
	}

	.article-body :global(table) {
		width: auto;
		max-width: 100%;
		border-collapse: collapse;
		margin: 0 0 1.2rem;
		font-size: 0.95rem;
		background: var(--bg-soft);
		border: 1px solid var(--border);
		border-radius: 6px;
		overflow: hidden;
	}

	.article-body :global(thead) {
		background: rgba(214, 176, 106, 0.1);
	}

	.article-body :global(th) {
		text-align: left;
		padding: 0.55rem 0.9rem;
		font-family: var(--font-display);
		font-size: 0.8rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--gold);
		border-bottom: 1px solid var(--border);
	}

	.article-body :global(td) {
		padding: 0.5rem 0.9rem;
		color: var(--text);
		border-bottom: 1px solid rgba(214, 176, 106, 0.1);
	}

	.article-body :global(tr:last-child td) {
		border-bottom: none;
	}

	.article-body :global(tbody tr:hover) {
		background: rgba(214, 176, 106, 0.04);
	}

	.article-body :global(a) {
		color: var(--gold);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.article-body :global(a:hover) {
		color: var(--gold-bright);
	}
</style>
