---
// Articles now live on Orboro.net; this route just redirects legacy/incoming
// /articles/<slug> links to the matching post there.
import { fetchOrboroPostsByCategory } from '../../lib/orboro-posts';

const { slug } = Astro.params;

let article;
try {
	const articles = await fetchOrboroPostsByCategory('world-of-warcraft');
	article = articles.find((a) => a.slug === slug);
} catch {
	article = undefined;
}

if (!article) {
	// Rewrite rather than redirect so an unknown slug answers 404 instead of a soft-404
	// (a 302 to /articles reads as a live page to crawlers).
	return Astro.rewrite('/404');
}

return Astro.redirect(article.url, 301);
---
