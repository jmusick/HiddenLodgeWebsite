---
import Layout from '../../layouts/Layout.astro';
import { fetchOrboroPostsByCategory, type OrboroPost } from '../../lib/orboro-posts';

const CATEGORY = 'world-of-warcraft';

let articles: OrboroPost[] = [];
let loadFailed = false;
try {
	articles = await fetchOrboroPostsByCategory(CATEGORY);
} catch {
	loadFailed = true;
}

function formatDate(date: string | null) {
	if (!date) return '';
	return new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout title="Articles | The Hidden Lodge" description="WoW writeups, opinions, and guides from The Hidden Lodge.">
	<section class="articles-header">
		<h1>Articles</h1>
		<p class="lead">Writeups, guides, and takes from The Hidden Lodge.</p>
	</section>

	<section class="articles-list">
		{loadFailed && (
			<p class="empty-state">Couldn't load articles right now. Try again in a few minutes.</p>
		)}
		{!loadFailed && articles.length === 0 && (
			<p class="empty-state">No articles yet. Check back soon.</p>
		)}
		{articles.map((article) => (
			<a class="article-card" href={article.url}>
				<div class="article-meta">
					<time datetime={article.publishedAt ?? undefined}>
						{formatDate(article.publishedAt)}
					</time>
				</div>
				<h2>{article.title}</h2>
				<p class="article-description">{article.excerpt}</p>
				<span class="read-more" aria-hidden="true">Read article →</span>
			</a>
		))}
	</section>
</Layout>

<style>
	.articles-header {
		padding-block: 2.5rem 1.5rem;
		border-bottom: 1px solid var(--border);
		margin-bottom: 2rem;
	}

	.articles-header h1 {
		font-size: 2.2rem;
		color: var(--gold-bright);
		margin: 0 0 0.4rem;
	}

	.lead {
		color: var(--muted);
		font-size: 1.05rem;
		margin: 0;
	}

	.articles-list {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		padding-bottom: 4rem;
	}

	.empty-state {
		color: var(--muted);
		font-style: italic;
	}

	.article-card {
		display: block;
		background: var(--bg-panel);
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 1.5rem 2rem;
		text-decoration: none;
		color: var(--text);
		transition: border-color 0.15s, background 0.15s;
	}

	.article-card:hover {
		border-color: var(--gold);
		background: rgba(214, 176, 106, 0.06);
	}

	.article-meta {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 0.6rem;
	}

	.article-meta time {
		font-size: 0.85rem;
		color: var(--muted);
		letter-spacing: 0.03em;
	}

	.article-card h2 {
		font-size: 1.3rem;
		color: var(--gold-bright);
		margin: 0 0 0.5rem;
		line-height: 1.3;
	}

	.article-description {
		color: var(--muted);
		margin: 0 0 1rem;
		line-height: 1.6;
		font-size: 0.97rem;
	}

	.read-more {
		font-size: 0.88rem;
		color: var(--gold);
		letter-spacing: 0.04em;
	}
</style>
