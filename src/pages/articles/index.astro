---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { fetchOrboroPostsByCategory, type OrboroPost } from '../../lib/orboro-posts';

const CATEGORY = 'world-of-warcraft';

let articles: OrboroPost[] = [];
let loadFailed = false;
try {
	articles = await fetchOrboroPostsByCategory(CATEGORY);
} catch {
	loadFailed = true;
}

function formatDate(date: string | null) {
	if (!date) return '';
	return new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout title="Articles | The Hidden Lodge" description="WoW writeups, opinions, and guides from The Hidden Lodge.">
	<section class="articles-header">
		<h1>Articles</h1>
		<p class="lead">Writeups, guides, and takes from The Hidden Lodge.</p>
	</section>

	<section class="articles-list">
		{loadFailed && (
			<p class="empty-state">Couldn't load articles right now. Try again in a few minutes.</p>
		)}
		{!loadFailed && articles.length === 0 && (
			<p class="empty-state">No articles yet. Check back soon.</p>
		)}
		{articles.map((article) => (
			<a class="card card--interactive article-card" href={article.url}>
				<div class="article-meta">
					<time datetime={article.publishedAt ?? undefined}>
						{formatDate(article.publishedAt)}
					</time>
				</div>
				<h2>{article.title}</h2>
				<p class="article-description">{article.excerpt}</p>
				<span class="read-more" aria-hidden="true">Read article →</span>
			</a>
		))}
	</section>

	<p class="credit">
		<Icon name="lucide:external-link" class="credit-icon" aria-hidden="true" />
		<span>
			Articles by <a href="https://orboro.net" target="_blank" rel="noopener noreferrer">Orboro.net</a>
		</span>
	</p>
</Layout>

<style>
	.articles-header {
		padding-block: var(--space-8) var(--space-7);
		border-bottom: 1px solid var(--border);
		margin-bottom: var(--space-8);
	}

	.articles-header h1 {
		color: var(--gold-bright);
		margin: 0 0 var(--space-3);
	}

	.lead {
		color: var(--muted);
		font-size: var(--text-lg);
		margin: 0;
	}

	.articles-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-7);
		margin-bottom: var(--space-7);
	}

	.article-card {
		display: block;
		text-decoration: none;
		color: var(--text);
		padding: var(--space-7) var(--space-8);
	}

	.article-meta {
		display: flex;
		align-items: center;
		gap: var(--space-6);
		margin-bottom: var(--space-4);
	}

	.article-meta time {
		font-size: var(--text-sm);
		color: var(--muted);
		letter-spacing: 0.03em;
	}

	.article-card h2 {
		font-size: var(--text-xl);
		color: var(--gold-bright);
		margin: 0 0 var(--space-4);
		line-height: var(--leading-tight);
	}

	.article-description {
		color: var(--muted);
		margin: 0 0 var(--space-6);
		line-height: var(--leading-loose);
		font-size: var(--text-base);
	}

	.read-more {
		font-size: var(--text-base);
		color: var(--gold);
		letter-spacing: 0.04em;
	}

	.credit {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		margin: 0 0 4rem;
		padding: var(--space-4) var(--space-6);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: rgb(var(--gold-rgb) / 0.05);
		color: var(--muted);
		font-size: var(--text-sm);
	}

	.credit-icon {
		width: 0.95rem;
		height: 0.95rem;
		flex: none;
		color: var(--gold);
	}

	.credit a {
		color: var(--gold);
		font-weight: 600;
		text-decoration: none;
	}

	.credit a:hover {
		color: var(--gold-bright);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
</style>
