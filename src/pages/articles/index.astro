---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

function formatDate(date: Date) {
	return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout title="Articles | The Hidden Lodge" description="WoW writeups, opinions, and guides from The Hidden Lodge.">
	<section class="articles-header">
		<h1>Articles</h1>
		<p class="lead">Writeups, guides, and takes from The Hidden Lodge.</p>
	</section>

	<section class="articles-list">
		{articles.length === 0 && (
			<p class="empty-state">No articles yet. Check back soon.</p>
		)}
		{articles.map((article) => (
			<a class="article-card" href={`/articles/${article.id}`}>
				<div class="article-meta">
					<time datetime={article.data.publishedAt.toISOString()}>
						{formatDate(article.data.publishedAt)}
					</time>
					{article.data.tags.length > 0 && (
						<ul class="tag-list" aria-label="Tags">
							{article.data.tags.map((tag) => (
								<li class="tag">{tag}</li>
							))}
						</ul>
					)}
				</div>
				<h2>{article.data.title}</h2>
				<p class="article-description">{article.data.description}</p>
				<span class="read-more" aria-hidden="true">Read article →</span>
			</a>
		))}
	</section>
</Layout>

<style>
	.articles-header {
		padding-block: 2.5rem 1.5rem;
		border-bottom: 1px solid var(--border);
		margin-bottom: 2rem;
	}

	.articles-header h1 {
		font-size: 2.2rem;
		color: var(--gold-bright);
		margin: 0 0 0.4rem;
	}

	.lead {
		color: var(--muted);
		font-size: 1.05rem;
		margin: 0;
	}

	.articles-list {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		padding-bottom: 4rem;
	}

	.empty-state {
		color: var(--muted);
		font-style: italic;
	}

	.article-card {
		display: block;
		background: var(--bg-panel);
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 1.5rem 2rem;
		text-decoration: none;
		color: var(--text);
		transition: border-color 0.15s, background 0.15s;
	}

	.article-card:hover {
		border-color: var(--gold);
		background: rgba(214, 176, 106, 0.06);
	}

	.article-meta {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 0.6rem;
	}

	.article-meta time {
		font-size: 0.85rem;
		color: var(--muted);
		letter-spacing: 0.03em;
	}

	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.tag {
		background: rgba(140, 167, 187, 0.15);
		border: 1px solid rgba(140, 167, 187, 0.3);
		color: var(--steel);
		font-size: 0.75rem;
		padding: 0.1em 0.55em;
		border-radius: 3px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.article-card h2 {
		font-size: 1.3rem;
		color: var(--gold-bright);
		margin: 0 0 0.5rem;
		line-height: 1.3;
	}

	.article-description {
		color: var(--muted);
		margin: 0 0 1rem;
		line-height: 1.6;
		font-size: 0.97rem;
	}

	.read-more {
		font-size: 0.88rem;
		color: var(--gold);
		letter-spacing: 0.04em;
	}
</style>
