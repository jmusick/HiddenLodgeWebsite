---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import PullHistoryTable from '../components/PullHistoryTable.astro';
import { env } from 'cloudflare:workers';
import { getBenchData, type BenchRaider, type BenchRole } from '../lib/bench';
import { naturalRole } from '../lib/raid-comp';
import { classColor } from '../lib/wow';
import type { AssignedRole } from '../lib/raid-teams';
import {
  PULL_SCORE_MIN_PULLS,
  getPullScoreRows,
  getPullScoreSummary,
  toPullHistoryEntries,
  type PullScoreRole,
  type PullScoreSummaryEntry,
} from '../lib/pull-scores';
import { BENCH_PARSE_DIFFICULTY } from '../lib/bench';
import { DEATH_ANALYSIS_RAID_NAME } from '../lib/death-analysis';
import { FEATURE_FLAGS } from '../lib/feature-flags';

if (!FEATURE_FLAGS.tools || !FEATURE_FLAGS.deathAnalysis || !FEATURE_FLAGS.parseAnalysis) {
  return Astro.redirect('/');
}

if (!Astro.locals.isGuildMember) {
  return Astro.redirect('/auth/login');
}

const DIFFICULTY_LABELS: Record<number, string> = { 3: 'Normal', 4: 'Heroic', 5: 'Mythic' };
const difficultyLabel = DIFFICULTY_LABELS[BENCH_PARSE_DIFFICULTY] ?? 'Heroic';

const bench = await getBenchData(env.DB);
const allRaiders: BenchRaider[] = [...bench.ranked, ...bench.belowMinimum];
const raiderByCharId = new Map(allRaiders.map((raider) => [raider.blizzardCharId, raider]));
const effectiveRoleByCharId = new Map<number, PullScoreRole>(allRaiders.map((raider) => [raider.blizzardCharId, raider.role]));

const rows = await getPullScoreRows(env.DB);
const rowsByChar = new Map<number, typeof rows>();
for (const row of rows) {
  const list = rowsByChar.get(row.blizzardCharId) ?? [];
  list.push(row);
  rowsByChar.set(row.blizzardCharId, list);
}

const summary = getPullScoreSummary(rows, effectiveRoleByCharId);

interface DisplayRow {
  entry: PullScoreSummaryEntry;
  raider: BenchRaider;
}

const bucketFor = (role: BenchRole, raider: BenchRaider): AssignedRole => {
  if (role === 'tank') return 'tank';
  if (role === 'healer') return 'healer';
  return naturalRole(raider);
};

const buckets: Record<AssignedRole, DisplayRow[]> = { tank: [], healer: [], 'melee-dps': [], 'ranged-dps': [] };
for (const entry of summary) {
  const raider = raiderByCharId.get(entry.blizzardCharId);
  if (!raider) continue;
  buckets[bucketFor(entry.role, raider)].push({ entry, raider });
}
for (const bucket of Object.values(buckets)) {
  bucket.sort((a, b) => (b.entry.pullScore ?? -1) - (a.entry.pullScore ?? -1) || a.raider.name.localeCompare(b.raider.name));
}

const bucketLabels: Record<AssignedRole, string> = {
  tank: 'Tanks',
  healer: 'Healers',
  'ranged-dps': 'Ranged',
  'melee-dps': 'Melee',
};
const bucketOrder: AssignedRole[] = ['tank', 'healer', 'ranged-dps', 'melee-dps'];

function trendLabel(row: DisplayRow): string {
  const { trendRecent, trendPrior } = row.entry;
  if (trendRecent === null || trendPrior === null) return '—';
  const delta = trendRecent - trendPrior;
  const arrow = delta > 0.5 ? '▲' : delta < -0.5 ? '▼' : '▬';
  return `${arrow} ${delta >= 0 ? '+' : ''}${delta.toFixed(1)}`;
}

const roleColumns: ReadonlyArray<{ label: string; help?: string; className?: string }> = [
  { label: 'Raider', help: `Character name and realm. Class color identifies the character class. Click to see the raider's pull history.` },
  {
    label: 'Pull Score',
    className: 'num',
    help: `Recency-weighted score from this raider's own ${difficultyLabel} pulls (kills and wipes) in this role, computed by this site — see "How this works" above. 50 is typical for the role that pull, 100 is twice typical or better. Needs at least ${PULL_SCORE_MIN_PULLS} scored pulls.`,
  },
  { label: 'Pulls', className: 'num', help: `Qualifying ${difficultyLabel} pulls (kills and wipes, 30s+) counted toward Pull Score.` },
  { label: 'Kills', className: 'num', help: 'Of those pulls, how many were kills — the only ones Warcraft Logs has a Parse for.' },
  {
    label: 'WCL Parse (kills)',
    className: 'num reference',
    help: `This raider's Warcraft Logs percentile parse, decay-weighted average across their counted kills. Reference only — never feeds Raid Comp scoring.`,
  },
  {
    label: 'WCL Parse (median)',
    className: 'num reference',
    help: `Warcraft Logs' own median parse for this role (same value shown on the Raid Composition Bench). Reference only — never feeds Raid Comp scoring.`,
  },
  {
    label: 'Trend (14d)',
    className: 'num',
    help: 'Change in weighted Pull Score comparing the last 14 days to the 46 days before that. ▲ improving, ▼ declining, ▬ flat.',
  },
];
---

<Layout title="Parse Analysis | The Hidden Lodge">
  <div class="parse-analysis-page">
    <PageHeader
      title="Parse Analysis"
      description={`How ${difficultyLabel} ${DEATH_ANALYSIS_RAID_NAME} performance is scored on this site, and how it compares to Warcraft Logs' own Parse.`}
    />

    <section class="card how-it-works">
      <h2>How this works</h2>
      <p>
        <strong>Pull Score</strong> is this site's own recency-weighted score, computed from every qualifying {difficultyLabel} pull —
        <strong>kills and wipes</strong> — at least 30 seconds long. On each pull, a raider's DPS (tanks/DPS) or HPS (healers) is compared
        to the median of everyone in that role on that pull: 50 is typical for the role that pull, 100 is twice typical or better. A
        raider's overall Pull Score is the weighted average of their own pulls in their effective role, with a 30-day half-life — a pull
        from 30 days ago counts half as much as one from today, so recent form matters more than a season-old streak. This is what feeds
        Raid Composition's scoring.
      </p>
      <p>
        <strong>WCL Parse</strong> is Warcraft Logs' own all-time percentile versus every log of that spec/boss/item-level bracket
        worldwide. It's shown here for reference only — it never feeds Raid Comp scoring — and only exists for <strong>kills</strong>,
        since Warcraft Logs' public API doesn't expose a percentile for wipes.
      </p>
      <p class="how-it-works-meta">
        Guild logs only, {difficultyLabel} only, pulls at least 30 seconds long. A raider needs at least {PULL_SCORE_MIN_PULLS} scored
        pulls in a role before Pull Score is shown for it.
      </p>
    </section>

    {bucketOrder.map((bucket) => (
      <section class="card role-section">
        <h2>{bucketLabels[bucket]}</h2>
        {buckets[bucket].length === 0 ? (
          <p class="empty-state">No scored raiders yet.</p>
        ) : (
          <div class="table-wrap">
            <table class="review-table parse-table">
              <colgroup>
                <col class="col-raider" />
                <col class="col-score" />
                <col class="col-pulls" />
                <col class="col-kills" />
                <col class="col-wcl-kills" />
                <col class="col-wcl-median" />
                <col class="col-trend" />
              </colgroup>
              <thead>
                <tr>
                  {roleColumns.map((column) => (
                    <th class={column.className}>
                      {column.help ? (
                        <button type="button" class="column-help" data-column-tooltip={column.help}>{column.label}</button>
                      ) : column.label}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {buckets[bucket].map((row) => {
                  const history = toPullHistoryEntries(rowsByChar.get(row.raider.blizzardCharId) ?? []);
                  const detailId = `pull-history-${row.raider.blizzardCharId}-${bucket}`;
                  return (
                    <>
                      <tr>
                        <td>
                          <button
                            type="button"
                            class="pull-history-toggle"
                            aria-expanded="false"
                            aria-controls={detailId}
                          >
                            <span class="cell-stack">
                              <strong style={`color: ${classColor(row.raider.className)}`}>{row.raider.name}</strong>
                              <small>{row.raider.realm}</small>
                            </span>
                          </button>
                        </td>
                        <td class="num">{row.entry.pullScore === null ? '—' : row.entry.pullScore.toFixed(1)}</td>
                        <td class="num">{row.entry.pulls}</td>
                        <td class="num">{row.entry.kills}</td>
                        <td class="num reference">{row.entry.wclParseKillAvg === null ? '—' : row.entry.wclParseKillAvg.toFixed(1)}</td>
                        <td class="num reference">{row.raider.wclParseMedian === null ? '—' : row.raider.wclParseMedian.toFixed(1)}</td>
                        <td class="num">{trendLabel(row)}</td>
                      </tr>
                      <tr id={detailId} class="pull-history-row" hidden>
                        <td colspan={roleColumns.length}>
                          <PullHistoryTable history={history} />
                        </td>
                      </tr>
                    </>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </section>
    ))}
  </div>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.pull-history-toggle').forEach((button) => {
    button.addEventListener('click', () => {
      const targetId = button.getAttribute('aria-controls');
      const detailRow = targetId ? document.getElementById(targetId) : null;
      if (!detailRow) return;
      const nowHidden = !detailRow.hidden;
      detailRow.hidden = nowHidden;
      button.setAttribute('aria-expanded', String(!nowHidden));
    });
  });

  // One shared HTML tooltip for every column-header "?" button, same pattern as Raid Composition's Roster table.
  const columnTooltip = document.createElement('div');
  columnTooltip.className = 'column-tooltip';
  columnTooltip.id = 'parse-analysis-column-tooltip';
  columnTooltip.role = 'tooltip';
  columnTooltip.hidden = true;
  document.body.append(columnTooltip);

  const hideColumnTooltip = (button?: HTMLButtonElement) => {
    columnTooltip.hidden = true;
    if (button) button.setAttribute('aria-expanded', 'false');
  };
  const showColumnTooltip = (button: HTMLButtonElement) => {
    columnTooltip.textContent = button.dataset.columnTooltip ?? '';
    columnTooltip.hidden = false;
    button.setAttribute('aria-describedby', columnTooltip.id);
    button.setAttribute('aria-expanded', 'true');
    const rect = button.getBoundingClientRect();
    const tooltipRect = columnTooltip.getBoundingClientRect();
    const horizontal = Math.max(10, Math.min(rect.left, window.innerWidth - tooltipRect.width - 10));
    const vertical = rect.bottom + tooltipRect.height + 10 <= window.innerHeight ? rect.bottom + 8 : Math.max(10, rect.top - tooltipRect.height - 8);
    columnTooltip.style.left = `${horizontal}px`;
    columnTooltip.style.top = `${vertical}px`;
  };
  for (const button of document.querySelectorAll<HTMLButtonElement>('.column-help')) {
    button.setAttribute('aria-expanded', 'false');
    button.addEventListener('mouseenter', () => showColumnTooltip(button));
    button.addEventListener('focus', () => showColumnTooltip(button));
    button.addEventListener('mouseleave', () => hideColumnTooltip(button));
    button.addEventListener('blur', () => hideColumnTooltip(button));
    button.addEventListener('click', () => {
      if (columnTooltip.hidden) showColumnTooltip(button);
      else hideColumnTooltip(button);
    });
  }
</script>

<style>
  .parse-analysis-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .how-it-works p {
    margin: 0 0 var(--space-4);
    color: var(--text);
  }

  .how-it-works p:last-child {
    margin-bottom: 0;
  }

  .how-it-works-meta {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .role-section h2 {
    margin: 0 0 var(--space-5);
  }

  /*
   * Same table primitives as raid-composition's Roster table (Configuration
   * Settings), copied rather than shared since that page's own tables predate
   * the design-token migration (DESIGN-SYSTEM.md schedules it last) — using
   * the same literals here, instead of the newer tokens, is what actually
   * makes the two look identical today.
   */
  .review-table {
    width: 100%;
    border-collapse: collapse;
  }

  /* Fixed, shared column widths so every role table's columns line up as if they were one table. */
  .parse-table {
    table-layout: fixed;
  }

  .parse-table .col-raider { width: 28%; }
  .parse-table .col-score { width: 13%; }
  .parse-table .col-pulls { width: 10%; }
  .parse-table .col-kills { width: 10%; }
  .parse-table .col-wcl-kills { width: 14%; }
  .parse-table .col-wcl-median { width: 14%; }
  .parse-table .col-trend { width: 11%; }

  .review-table th,
  .review-table :global(td) {
    padding: 0.55rem 0.4rem;
    border-bottom: 1px solid rgba(214, 176, 106, 0.15);
    vertical-align: middle;
  }

  .review-table th {
    text-align: left;
    color: #f2dfb5;
    font-weight: 700;
    font-size: 0.82rem;
    white-space: nowrap;
    vertical-align: bottom;
  }

  .review-table :global(tbody tr:hover) {
    background: rgba(214, 176, 106, 0.05);
  }

  .review-table th.num,
  .review-table :global(td.num) {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  /* Reference-only columns (WCL Parse) — greyed to distinguish them from the scoring inputs. */
  .review-table th.reference :global(.column-help),
  .review-table :global(td.reference) {
    color: #8fa3b3;
  }

  .review-table :global(.cell-stack) {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .review-table :global(.cell-stack small) {
    color: #aea99f;
    font-size: 0.8rem;
  }

  /*
   * The whole Raider cell is the expand/collapse trigger for that raider's
   * pull history — the ▾/▴ suffix is the same affordance death-analysis.astro
   * uses for its per-raider death list, so "click a name to expand" reads the
   * same way across the site.
   */
  .pull-history-toggle {
    display: block;
    width: 100%;
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
    text-align: left;
  }

  .pull-history-toggle::after {
    content: ' ▾';
    color: var(--gold, #d6b06a);
  }

  .pull-history-toggle[aria-expanded='true']::after {
    content: ' ▴';
  }

  .pull-history-toggle:hover,
  .pull-history-toggle:focus-visible {
    color: #fff3da;
  }

  .pull-history-row td {
    padding-block: 0.9rem;
    background: rgba(10, 17, 26, 0.5);
  }

  /*
   * The header label is itself the tooltip trigger — a real button so it stays
   * keyboard reachable, styled as plain header text with a dotted underline as
   * the "there's an explanation here" affordance. Same pattern as raid-composition.astro.
   */
  .column-help {
    display: inline;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: inherit;
    text-decoration: underline dotted rgba(214, 176, 106, 0.55);
    text-underline-offset: 0.25em;
    cursor: help;
  }

  .column-help:hover,
  .column-help:focus-visible {
    color: #fff3da;
    text-decoration-color: #f2dfb5;
    outline: none;
  }

  :global(.column-tooltip) {
    position: fixed;
    z-index: 50;
    box-sizing: border-box;
    width: min(21rem, calc(100vw - 1.25rem));
    padding: 0.65rem 0.75rem;
    border: 1px solid rgba(214, 176, 106, 0.65);
    border-radius: 0.45rem;
    background: #15100a;
    box-shadow: 0 0.65rem 1.5rem rgba(0, 0, 0, 0.42);
    color: #f2dfb5;
    font-size: 0.82rem;
    font-weight: 400;
    line-height: 1.35;
    pointer-events: none;
  }
</style>
