---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { fetchBookmarksByTag, countCategories, TAGSTASH_PROFILE_URL, type Bookmark } from '../lib/bookmarks';

const TAG = 'wow';

let bookmarks: Bookmark[] = [];
let loadFailed = false;
try {
  bookmarks = await fetchBookmarksByTag(TAG);
} catch {
  loadFailed = true;
}

const categories = countCategories(bookmarks);
const creditUrl = 'https://tagsta.sh/?utm_source=hiddenlodge&utm_medium=referral&utm_campaign=links_credit';
---

<Layout title="The Hidden Lodge | Useful Links" description="Curated WoW resources for raiding, M+, UI, and gearing.">
  <section class="intro">
    <h1 class="title-row"><Icon name="lucide:link" class="title-icon" aria-hidden="true" />Useful Links</h1>
    <p>
      A curated toolbox from guild Discord. Open these in a new tab and keep them handy for prep, logs,
      progression planning, and Mythic+ grinding.
    </p>
  </section>

  {
    loadFailed && (
      <p class="notice">Couldn't load the link list right now. Try again in a few minutes.</p>
    )
  }

  {
    !loadFailed && bookmarks.length === 0 && (
      <p class="notice">No links have been tagged "{TAG}" yet.</p>
    )
  }

  {
    bookmarks.length > 0 && (
      <div id="links-root">
        {categories.length > 0 && (
          <div class="cats" role="group" aria-label="Filter links by category">
            <button type="button" class="cat cat--active" data-category="">
              All <span class="cat-count">{bookmarks.length}</span>
            </button>
            {categories.map((cat) => (
              <button type="button" class="cat" data-category={cat.name}>
                {cat.name} <span class="cat-count">{cat.count}</span>
              </button>
            ))}
          </div>
        )}

        <div class="link-grid">
          {bookmarks.map((b) => (
            <a
              class="link-card"
              data-categories={b.categories.join(' ')}
              href={b.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {b.faviconUrl ? (
                <img class="link-favicon" src={b.faviconUrl} alt="" loading="lazy" referrerpolicy="no-referrer" />
              ) : (
                <span class="link-favicon link-favicon--placeholder" aria-hidden="true" />
              )}
              <span class="link-body">
                <span class="link-title">{b.title}</span>
                {b.description && <span class="link-desc">{b.description}</span>}
              </span>
            </a>
          ))}
        </div>

        <p class="credit">
          <Icon name="lucide:tag" class="credit-icon" aria-hidden="true" />
          <span>
            This list is powered by <a href={creditUrl} target="_blank" rel="noopener noreferrer">Tagstash</a> —
            organize and share your own bookmarks, or browse
            <a href={TAGSTASH_PROFILE_URL} target="_blank" rel="noopener noreferrer">the full collection</a>.
          </span>
        </p>
      </div>
    )
  }
</Layout>

<script>
  function initLinkFilters() {
    const root = document.getElementById('links-root');
    if (!root || root.dataset.filtersInit) return;
    root.dataset.filtersInit = '1';

    const chips = root.querySelectorAll<HTMLButtonElement>('.cat');
    const cards = root.querySelectorAll<HTMLAnchorElement>('.link-card');

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.classList.remove('cat--active'));
        chip.classList.add('cat--active');

        const category = chip.dataset.category ?? '';
        cards.forEach((card) => {
          const cats = (card.dataset.categories || '').split(' ');
          card.hidden = category !== '' && !cats.includes(category);
        });
      });
    });
  }

  initLinkFilters();
  document.addEventListener('astro:page-load', initLinkFilters);
</script>

<style>
  .intro h1 {
    margin-top: 0;
    margin-bottom: 0.55rem;
    font-size: clamp(2rem, 3.2vw, 3.05rem);
  }

  .intro p {
    max-width: 78ch;
    color: #d8e2e8;
    font-size: 1.05rem;
  }

  .notice {
    margin-top: 1.25rem;
    color: #d8e2e8;
    font-style: italic;
  }

  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1.25rem 0 1rem;
  }

  .cat {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid rgba(214, 176, 106, 0.38);
    border-radius: 999px;
    background: transparent;
    color: #d8e2e8;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .cat:hover,
  .cat:focus-visible {
    border-color: rgba(214, 176, 106, 0.7);
    background: rgba(214, 176, 106, 0.1);
    color: #f5e4be;
  }

  .cat--active,
  .cat--active:hover {
    background: rgba(214, 176, 106, 0.85);
    border-color: rgba(214, 176, 106, 0.85);
    color: #0b1520;
  }

  .cat-count {
    font-size: 0.74rem;
    opacity: 0.75;
  }

  .link-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .link-card {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    padding: 0.55rem 0.75rem;
    border: 1px solid rgba(214, 176, 106, 0.38);
    border-left: 3px solid rgba(214, 176, 106, 0.85);
    border-radius: 0.6rem;
    background:
      linear-gradient(160deg, rgba(214, 176, 106, 0.08), transparent 45%),
      rgba(11, 21, 32, 0.78);
    color: #d8e2e8;
    text-decoration: none;
    transition: border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
  }

  .link-card:hover,
  .link-card:focus-visible {
    border-color: rgba(214, 176, 106, 0.7);
    background:
      linear-gradient(160deg, rgba(214, 176, 106, 0.16), transparent 55%),
      rgba(11, 21, 32, 0.85);
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.28);
    color: #f5e4be;
  }

  .link-card[hidden] {
    display: none;
  }

  .link-favicon {
    width: 1rem;
    height: 1rem;
    flex: none;
    border-radius: 2px;
  }

  .link-favicon--placeholder {
    background: rgba(214, 176, 106, 0.12);
    border: 1px solid rgba(214, 176, 106, 0.38);
  }

  .link-body {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .link-title {
    font-size: 1.01rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .link-desc {
    color: #9fb0bd;
    font-size: 0.8rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .credit {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 1.5rem 0 0;
    padding: 0.75rem 1rem;
    border: 1px solid rgba(214, 176, 106, 0.28);
    border-radius: 0.6rem;
    background: rgba(11, 21, 32, 0.6);
    color: #d8e2e8;
    font-size: 0.88rem;
  }

  .credit-icon {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
    color: #e4c27a;
  }

  .credit a {
    color: #e4c27a;
    font-weight: 600;
  }

  .credit a:hover {
    text-decoration: underline;
  }

  .title-row {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .title-icon {
    width: 1rem;
    height: 1rem;
    color: #f1d9a9;
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .link-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
