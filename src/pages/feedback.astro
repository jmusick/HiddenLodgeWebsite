---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { FEATURE_FLAGS } from '../lib/feature-flags';

if (!FEATURE_FLAGS.feedback) {
  return Astro.redirect('/');
}

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/auth/login');
}

if (!Astro.locals.isGuildMember) {
  return new Response('Guild membership required.', { status: 403 });
}

const pageUrl = new URL(Astro.request.url);
const statusParam = pageUrl.searchParams.get('status');
---

<Layout title="Guild Feedback | The Hidden Lodge" description="Submit anonymous feedback or concerns to guild leadership.">
  <section class="card feedback-panel">
    <h1 class="title-row"><Icon name="lucide:message-square-warning" class="title-icon" aria-hidden="true" />Guild Feedback & Concerns</h1>
    <p class="intro-copy">
      Use this form to share concerns, suggestions, or guild feedback. Submissions are completely anonymous unless you choose to include your name.
    </p>

    {statusParam === 'ok' && (
      <p class="flash flash-ok" role="status">Feedback submitted. Thank you for sharing this with leadership.</p>
    )}
    {statusParam === 'invalid' && (
      <p class="flash flash-error" role="alert">Please include feedback (5 to 2000 characters).</p>
    )}
    {statusParam === 'error' && (
      <p class="flash flash-error" role="alert">Unable to submit feedback right now. Please try again.</p>
    )}

    <form method="POST" action="/api/feedback/create" class="feedback-form">
      <input type="hidden" name="return_to" value="/feedback" />

      <label for="display_name">Name (optional)</label>
      <input
        id="display_name"
        name="display_name"
        type="text"
        maxlength="80"
        placeholder="Optional: include a name if you want follow-up"
        autocomplete="off"
      />

      <label for="message">Feedback or concern</label>
      <textarea
        id="message"
        name="message"
        rows="8"
        minlength="5"
        maxlength="2000"
        required
        placeholder="Share what happened, what concern you have, or what we can improve."
      ></textarea>

      <button class="btn btn--primary" type="submit">Submit Feedback</button>
    </form>
  </section>
</Layout>

<style>
  .feedback-panel {
    margin-top: var(--space-6);
    background:
      linear-gradient(160deg, rgb(var(--gold-rgb) / 0.08), transparent 45%),
      var(--surface-raised);
  }

  .intro-copy {
    max-width: 72ch;
    color: var(--text);
    margin-top: var(--space-3);
  }

  .flash {
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    border: 1px solid;
    font-weight: 600;
  }

  .flash-ok {
    border-color: var(--success);
    background: var(--success-bg);
    color: var(--success);
  }

  .flash-error {
    border-color: var(--danger);
    background: var(--danger-bg);
    color: var(--danger);
  }

  .feedback-form {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-4);
    max-width: 48rem;
  }

  .feedback-form label {
    color: var(--gold);
    font-weight: 700;
    font-size: var(--text-base);
  }

  .feedback-form input,
  .feedback-form textarea {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    padding: var(--space-4);
  }

  .feedback-form textarea {
    min-height: 10rem;
    resize: vertical;
  }

  .feedback-form button {
    justify-self: start;
  }
</style>
