---
import Layout from '../layouts/Layout.astro';

// Reached directly and via Astro.rewrite('/404') from routes that resolve nothing
// (e.g. an unknown article slug), so the status is set here rather than at each caller.
Astro.response.status = 404;
---

<Layout
	title="Page Not Found | The Hidden Lodge"
	description="That page doesn't exist. Head back to The Hidden Lodge."
>
	<div class="notfound-wrap">
		<div class="card notfound-card">
			<p class="notfound-label">Error 404</p>
			<h1>This Path Leads Nowhere</h1>
			<p class="notfound-body">
				The page you're looking for doesn't exist, or it moved somewhere we forgot to
				write down. Either way, there's nothing here.
			</p>
			<div class="notfound-links">
				<a href="/">Home</a>
				<a href="/roster">Roster</a>
				<a href="/raiding">Raiding</a>
				<a href="/articles">Articles</a>
			</div>
		</div>
	</div>
</Layout>

<style>
	.notfound-wrap {
		display: flex;
		justify-content: center;
		align-items: center;
		min-height: 50vh;
	}

	.notfound-card {
		max-width: 38rem;
		width: 100%;
		text-align: center;
		padding: var(--space-8) var(--space-7);
		border-radius: var(--radius-xl);
		backdrop-filter: blur(6px);
	}

	.notfound-label {
		margin: 0 0 var(--space-5);
		font-size: var(--text-sm);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--gold);
		opacity: 0.8;
	}

	h1 {
		margin: 0 0 var(--space-7);
		color: var(--gold-bright);
		text-shadow: 0 0 24px rgb(var(--gold-rgb) / 0.22);
	}

	.notfound-body {
		margin: 0 0 var(--space-6);
		color: var(--muted);
		font-size: var(--text-lg);
		line-height: 1.6;
	}

	.notfound-links {
		display: flex;
		justify-content: center;
		gap: var(--space-5);
		flex-wrap: wrap;
		margin-top: var(--space-7);
	}

	.notfound-links a {
		padding: var(--space-4) var(--space-6);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		color: var(--gold);
		font-weight: 600;
		font-size: var(--text-base);
		transition: background var(--transition-fast), color var(--transition-fast);
	}

	.notfound-links a:hover {
		background: var(--surface-hover);
		color: var(--gold-bright);
	}
</style>
