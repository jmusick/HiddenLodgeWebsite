---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';
import {
  DEATH_ANALYSIS_RAID_NAME,
  DEATH_ANALYSIS_WINDOW_DAYS,
  canManageLogMatching,
  getDeathAnalysisNights,
  raidWindowForNight,
} from '../../lib/death-analysis';
import { FEATURE_FLAGS } from '../../lib/feature-flags';

if (!Astro.locals.user) {
  return Astro.redirect('/');
}

if (!FEATURE_FLAGS.deathAnalysis) {
  return Astro.redirect('/admin');
}

if (!(await canManageLogMatching(env.DB, Astro.locals.user, Astro.locals.isAdmin))) {
  return Astro.redirect('/');
}

const nights = await getDeathAnalysisNights(env.DB);
const statusParam = new URL(Astro.request.url).searchParams.get('status');

const nightFormatter = new Intl.DateTimeFormat('en-US', {
  timeZone: 'America/New_York',
  weekday: 'short',
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
const timeFormatter = new Intl.DateTimeFormat('en-US', {
  timeZone: 'America/New_York',
  hour: 'numeric',
  minute: '2-digit',
});

function nightLabel(nightKey: string): string {
  const window = raidWindowForNight(nightKey);
  return window ? nightFormatter.format(new Date(window.startUtc * 1000)) : nightKey;
}

function reportTimes(startUtc: number, endUtc: number): string {
  return `${timeFormatter.format(new Date(startUtc * 1000))}–${timeFormatter.format(new Date(endUtc * 1000))} ET`;
}
---

<AdminLayout title="Log Matching | Admin | The Hidden Lodge">
  <div class="log-matching-page">
    {statusParam === 'override-saved' && (
      <div class="flash flash-ok" role="status">Log override saved. Death Analysis now uses that report for the night.</div>
    )}
    {statusParam === 'override-cleared' && (
      <div class="flash flash-ok" role="status">Override cleared. The night is back to automatic matching.</div>
    )}
    {statusParam === 'sync-ok' && (
      <div class="flash flash-ok" role="status">Sync finished. All in-window reports are processed.</div>
    )}
    {statusParam === 'sync-partial' && (
      <div class="flash flash-ok" role="status">Sync processed a batch of reports. More are pending; they will finish on the next cron runs or another sync.</div>
    )}
    {statusParam === 'sync-rate-limited' && (
      <div class="flash flash-error" role="alert">Warcraft Logs rate limit hit. Sync paused; it will resume automatically.</div>
    )}
    {statusParam === 'sync-error' && (
      <div class="flash flash-error" role="alert">Sync failed. Check server logs.</div>
    )}
    {statusParam === 'error' && (
      <div class="flash flash-error" role="alert">Could not save the override. Check that the report is a {DEATH_ANALYSIS_RAID_NAME} log and see server logs.</div>
    )}

    <div class="page-header">
      <div>
        <h1>Log Matching</h1>
        <p class="page-desc">
          Every Thursday and Friday raid night (9pm–midnight ET) from the last {DEATH_ANALYSIS_WINDOW_DAYS} days. When more than one person logged a night, Death Analysis counts only one report: the one with the most Heroic/Mythic {DEATH_ANALYSIS_RAID_NAME} pulls, unless you pick a different one here. Reports sync automatically on the cron.
        </p>
      </div>
      {Astro.locals.isAdmin && (
        <div class="header-actions">
          <form method="POST" action="/api/admin/death-analysis/refresh" class="sync-form">
            <button type="submit" class="sync-btn">Sync Now</button>
          </form>
        </div>
      )}
    </div>

    <section class="admin-section">
      <div class="table-wrap">
        <table class="review-table">
          <thead>
            <tr>
              <th>Raid Night</th>
              <th>Counted Report</th>
              <th>Other Reports</th>
              <th>Override</th>
            </tr>
          </thead>
          <tbody>
            {nights.map((night) => {
              const others = night.reports.filter((report) => report.code !== night.canonical?.code);
              return (
                <tr>
                  <td>
                    <div class="cell-stack">
                      <strong>{nightLabel(night.nightKey)}</strong>
                      <small>{night.reports.length} report{night.reports.length === 1 ? '' : 's'} found</small>
                    </div>
                  </td>
                  <td>
                    {night.canonical ? (
                      <div class="cell-stack">
                        <a href={`https://www.warcraftlogs.com/reports/${night.canonical.code}`} target="_blank" rel="noopener noreferrer">{night.canonical.code}</a>
                        <small>{night.canonical.bossPulls} pulls · {night.canonical.bossKills} kills · {reportTimes(night.canonical.startUtc, night.canonical.endUtc)}</small>
                        <small>{night.isOverride ? 'Manual override' : 'Auto-matched'}</small>
                      </div>
                    ) : night.overrideCode ? (
                      <span class="cell-subtext">Override {night.overrideCode} not synced yet</span>
                    ) : (
                      <span class="cell-subtext">No qualifying report</span>
                    )}
                  </td>
                  <td>
                    {others.length === 0 ? (
                      <span class="cell-subtext">—</span>
                    ) : (
                      <div class="cell-stack">
                        {others.map((report) => (
                          <small>
                            <a href={`https://www.warcraftlogs.com/reports/${report.code}`} target="_blank" rel="noopener noreferrer">{report.code}</a>
                            {' '}· {report.bossPulls} pulls · {reportTimes(report.startUtc, report.endUtc)}
                          </small>
                        ))}
                      </div>
                    )}
                  </td>
                  <td>
                    <form method="POST" action="/api/admin/death-analysis/log-override" class="override-form">
                      <input type="hidden" name="night_key" value={night.nightKey} />
                      <select name="report_code" class="override-select">
                        <option value="" selected={!night.overrideCode}>Auto match (no override)</option>
                        {night.reports.map((report) => (
                          <option value={report.code} selected={night.overrideCode === report.code}>
                            {report.code} ({report.bossPulls} pulls)
                          </option>
                        ))}
                      </select>
                      <input
                        type="text"
                        name="report_code_manual"
                        class="override-input"
                        placeholder="Or paste WCL URL/code"
                        inputmode="url"
                        autocomplete="off"
                      />
                      <button type="submit" class="save-btn">Save</button>
                    </form>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</AdminLayout>

<style>
  .log-matching-page {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .page-desc {
    margin: 0.35rem 0 0;
    color: #c7c2b8;
    max-width: 70ch;
  }

  .header-actions {
    flex-shrink: 0;
  }

  .sync-btn {
    border: 1px solid rgba(214, 176, 106, 0.55);
    border-radius: 0.45rem;
    background: rgba(214, 176, 106, 0.12);
    color: #f3e2be;
    padding: 0.45rem 0.8rem;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 160ms ease, background 160ms ease;
    white-space: nowrap;
  }

  .sync-btn:hover,
  .sync-btn:focus-visible {
    border-color: rgba(214, 176, 106, 0.8);
    background: rgba(214, 176, 106, 0.2);
  }

  .admin-section {
    border: 1px solid rgba(214, 176, 106, 0.2);
    border-radius: 0.7rem;
    padding: 1rem;
    background: rgba(11, 7, 2, 0.45);
  }

  .section-copy {
    margin: 0.25rem 0 0;
    color: #c7c2b8;
  }

  .table-wrap {
    overflow-x: auto;
  }

  .review-table {
    width: 100%;
    border-collapse: collapse;
  }

  .review-table th,
  .review-table td {
    padding: 0.65rem 0.55rem;
    border-bottom: 1px solid rgba(214, 176, 106, 0.15);
    vertical-align: top;
  }

  .review-table th {
    text-align: left;
    color: #f2dfb5;
    font-weight: 700;
  }

  .cell-stack {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .cell-stack small,
  .cell-subtext {
    color: #aea99f;
    font-size: 0.82rem;
  }

  .override-form {
    display: flex;
    gap: 0.45rem;
    align-items: center;
    min-width: 28rem;
  }

  .override-select {
    min-width: 14rem;
    width: 100%;
    border: 1px solid rgba(214, 176, 106, 0.3);
    border-radius: 0.45rem;
    background: rgba(12, 8, 2, 0.75);
    color: #f7efe0;
    padding: 0.4rem 0.45rem;
  }

  .override-input {
    min-width: 13rem;
    width: 100%;
    border: 1px solid rgba(214, 176, 106, 0.3);
    border-radius: 0.45rem;
    background: rgba(12, 8, 2, 0.75);
    color: #f7efe0;
    padding: 0.4rem 0.45rem;
  }

  .override-input::placeholder {
    color: #9d978b;
  }

  .save-btn {
    border: 1px solid rgba(214, 176, 106, 0.45);
    border-radius: 0.45rem;
    background: rgba(34, 22, 6, 0.8);
    color: #f8e6bf;
    padding: 0.42rem 0.72rem;
    font-weight: 600;
    cursor: pointer;
  }

  .save-btn:hover {
    background: rgba(50, 31, 7, 0.9);
  }

  .flash {
    border-radius: 0.6rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid transparent;
  }

  .flash-ok {
    background: rgba(36, 86, 42, 0.25);
    border-color: rgba(102, 191, 114, 0.55);
    color: #d5f2da;
  }

  .flash-error {
    background: rgba(101, 28, 28, 0.24);
    border-color: rgba(212, 82, 82, 0.55);
    color: #ffd6d6;
  }

  @media (max-width: 900px) {
    .override-form {
      min-width: 0;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }

    .override-select {
      min-width: 0;
    }

    .save-btn {
      width: 100%;
    }
  }
</style>
