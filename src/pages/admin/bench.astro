---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';
import { BENCH_PARSE_DIFFICULTY, getBenchData, type BenchRaider } from '../../lib/bench';
import { DEATH_ANALYSIS_RAID_NAME } from '../../lib/death-analysis';
import { FEATURE_FLAGS } from '../../lib/feature-flags';
import { classColor } from '../../lib/wow';

if (!Astro.locals.user) {
  return Astro.redirect('/');
}

if (!FEATURE_FLAGS.deathAnalysis) {
  return Astro.redirect('/admin');
}

if (!Astro.locals.isOfficer) {
  return Astro.redirect('/');
}

const bench = await getBenchData(env.DB);
const statusParam = new URL(Astro.request.url).searchParams.get('status');
const DIFFICULTY_LABELS: Record<number, string> = { 3: 'Normal', 4: 'Heroic', 5: 'Mythic' };
const difficultyLabel = DIFFICULTY_LABELS[BENCH_PARSE_DIFFICULTY] ?? 'Heroic';
const timestampLabel = (epoch: number | null) =>
  epoch ? `${new Date(epoch * 1000).toLocaleString('en-US', { timeZone: 'America/New_York' })} ET` : 'Never';

const toClient = (raider: BenchRaider) => ({ ...raider, color: classColor(raider.className) });
const clientData = {
  ranked: bench.ranked.map(toClient),
  belowMinimum: bench.belowMinimum.map(toClient),
  minimumPulls: bench.summary.minimumPulls,
  minimumReports: bench.summary.minimumReports,
  difficultyLabel,
};
---

<AdminLayout title="Bench | Admin | The Hidden Lodge">
  <div class="bench-page">
    {statusParam === 'refresh-ok' && (
      <div class="flash flash-ok" role="status">Parses refreshed from Warcraft Logs.</div>
    )}
    {statusParam === 'refresh-partial' && (
      <div class="flash flash-ok" role="status">Refreshed a batch of parses. The rest will finish on the next cron run or another refresh.</div>
    )}
    {statusParam === 'refresh-rate-limited' && (
      <div class="flash flash-error" role="alert">Warcraft Logs rate limit hit. Parses will resume refreshing automatically.</div>
    )}
    {statusParam === 'refresh-error' && (
      <div class="flash flash-error" role="alert">Parse refresh failed. Check server logs.</div>
    )}
    {statusParam === 'role-saved' && (
      <div class="flash flash-ok" role="status">Role saved.</div>
    )}
    {statusParam === 'error' && (
      <div class="flash flash-error" role="alert">Could not save that change. Check server logs.</div>
    )}

    <div class="page-header">
      <div>
        <h1>Bench</h1>
        <p class="page-desc">
          Suggested bench order from Death Analysis plus each raider's median {difficultyLabel} {DEATH_ANALYSIS_RAID_NAME} parse
          on Warcraft Logs (DPS and tanks by damage, healers by healing). Lowest combined score is benched first. Check your
          raid composition before benching a tank or healer.
        </p>
        <p class="page-meta">
          Parses updated: {timestampLabel(bench.lastParseSyncAt)} · Deaths updated: {timestampLabel(bench.summary.lastSyncedAt)}
        </p>
      </div>
      <div class="header-actions">
        <form method="POST" action="/api/admin/bench/refresh">
          <button type="submit" class="action-btn">Refresh Parses</button>
        </form>
      </div>
    </div>

    <section class="admin-section controls" aria-label="Scoring controls">
      <div class="control weight-control">
        <label for="bench-weight" class="control-label">Weighting</label>
        <div class="slider-row">
          <span class="slider-end">Parse</span>
          <input id="bench-weight" type="range" min="0" max="100" step="5" value="60" />
          <span class="slider-end">Deaths</span>
        </div>
        <output id="bench-weight-label" for="bench-weight" class="weight-readout">Parse 60% · Deaths 40%</output>
      </div>

      <fieldset class="control">
        <legend class="control-label">Parse scale</legend>
        <div class="segmented">
          <label><input type="radio" name="bench-scale" value="percentile" checked /> Guild percentile</label>
          <label><input type="radio" name="bench-scale" value="raw" /> Raw WCL parse</label>
        </div>
      </fieldset>

      <fieldset class="control">
        <legend class="control-label">Role</legend>
        <div class="segmented">
          <label><input type="radio" name="bench-role" value="all" checked /> All</label>
          <label><input type="radio" name="bench-role" value="tank" /> Tank</label>
          <label><input type="radio" name="bench-role" value="healer" /> Healer</label>
          <label><input type="radio" name="bench-role" value="dps" /> DPS</label>
        </div>
      </fieldset>

      <p id="bench-formula" class="formula"></p>
    </section>

    <section class="admin-section">
      <h2>Bench Order</h2>
      <p class="section-copy">
        Raiders with {bench.summary.minimumPulls}+ boss pulls across {bench.summary.minimumReports}+ reports and a parse in their role.
        Percentiles compare the whole ranked guild, even when a role filter is on.
      </p>
      <div class="table-wrap">
        <table class="review-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Raider</th>
              <th>Role</th>
              <th class="num">Median Parse</th>
              <th class="num">Parse Score</th>
              <th class="num">Death Score</th>
              <th class="num">Death Pct</th>
              <th class="num">Combined</th>
            </tr>
          </thead>
          <tbody id="bench-ranked-body"></tbody>
        </table>
      </div>
      <p id="bench-ranked-empty" class="empty-state" hidden>No raiders to rank yet.</p>
    </section>

    <section class="admin-section">
      <h2>Not Scored</h2>
      <p class="section-copy">
        Not enough death data (under {bench.summary.minimumPulls} pulls or {bench.summary.minimumReports} reports), or no parse in
        their role. Shown with parse only, not ranked.
      </p>
      <div class="table-wrap">
        <table class="review-table">
          <thead>
            <tr>
              <th>Raider</th>
              <th>Role</th>
              <th class="num">Median Parse</th>
              <th class="num">Bosses</th>
              <th class="num">Pulls</th>
              <th class="num">Reports</th>
              <th>Reason</th>
            </tr>
          </thead>
          <tbody id="bench-unscored-body"></tbody>
        </table>
      </div>
      <p id="bench-unscored-empty" class="empty-state" hidden>Everyone has enough data.</p>
    </section>
  </div>
</AdminLayout>

<script is:inline type="application/json" id="bench-data" set:html={JSON.stringify(clientData).replace(/</g, '\\u003c')}></script>

<script>
  type Role = 'dps' | 'healer' | 'tank';
  interface Raider {
    blizzardCharId: number;
    name: string;
    realm: string;
    color: string;
    reportCount: number;
    fightsPresent: number;
    weightedScore: number;
    role: Role;
    autoRole: Role;
    roleOverride: Role | null;
    parse: number | null;
    parseBosses: number;
    parseStatus: 'ok' | 'no-role-parse' | 'not-found' | 'pending';
  }
  interface BenchClientData {
    ranked: Raider[];
    belowMinimum: Raider[];
    minimumPulls: number;
    minimumReports: number;
    difficultyLabel: string;
  }

  const ROLE_LABELS: Record<Role, string> = { dps: 'DPS', healer: 'Healer', tank: 'Tank' };
  const STORAGE_KEY = 'hl-bench-settings';

  const data = JSON.parse(document.getElementById('bench-data')?.textContent ?? '{}') as BenchClientData;
  const weightInput = document.getElementById('bench-weight') as HTMLInputElement;
  const weightLabel = document.getElementById('bench-weight-label') as HTMLOutputElement;
  const formula = document.getElementById('bench-formula') as HTMLParagraphElement;
  const rankedBody = document.getElementById('bench-ranked-body') as HTMLTableSectionElement;
  const unscoredBody = document.getElementById('bench-unscored-body') as HTMLTableSectionElement;

  const scored = data.ranked.filter((raider) => raider.parseStatus === 'ok');
  const unscored = [...data.ranked.filter((raider) => raider.parseStatus !== 'ok'), ...data.belowMinimum];

  /** Google Sheets PERCENTRANK.INC: share of the pool strictly below `value`, 0–1. */
  function percentRank(pool: number[], value: number): number {
    if (pool.length <= 1) return 1;
    return pool.filter((entry) => entry < value).length / (pool.length - 1);
  }

  const deathPool = scored.map((raider) => raider.weightedScore);
  const parsePool = scored.map((raider) => raider.parse ?? 0);

  function readSettings(): { weight: number; scale: string; role: string } {
    const defaults = { weight: 60, scale: 'percentile', role: 'all' };
    try {
      const stored = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? 'null');
      if (!stored) return defaults;
      const weight = Number(stored.weight);
      return {
        weight: Number.isFinite(weight) && weight >= 0 && weight <= 100 ? weight : defaults.weight,
        scale: stored.scale === 'raw' ? 'raw' : 'percentile',
        role: ['all', 'dps', 'healer', 'tank'].includes(stored.role) ? stored.role : 'all',
      };
    } catch {
      return defaults;
    }
  }

  function saveSettings(settings: { weight: number; scale: string; role: string }): void {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(settings));
    } catch {
      // Per-viewer convenience only.
    }
  }

  function currentSettings() {
    return {
      weight: Number(weightInput.value),
      scale: (document.querySelector('input[name="bench-scale"]:checked') as HTMLInputElement | null)?.value ?? 'percentile',
      role: (document.querySelector('input[name="bench-role"]:checked') as HTMLInputElement | null)?.value ?? 'all',
    };
  }

  function cell(text: string, className?: string): HTMLTableCellElement {
    const td = document.createElement('td');
    td.textContent = text;
    if (className) td.className = className;
    return td;
  }

  function raiderCell(raider: Raider): HTMLTableCellElement {
    const td = document.createElement('td');
    const stack = document.createElement('div');
    stack.className = 'cell-stack';
    const name = document.createElement('strong');
    name.textContent = raider.name;
    name.style.color = raider.color;
    const realm = document.createElement('small');
    realm.textContent = raider.realm;
    stack.append(name, realm);
    td.append(stack);
    return td;
  }

  /** Posts to the role-override endpoint on change; "Auto" clears the override. */
  function roleCell(raider: Raider): HTMLTableCellElement {
    const td = document.createElement('td');
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/api/admin/bench/role-override';
    form.className = 'role-form';
    const id = document.createElement('input');
    id.type = 'hidden';
    id.name = 'blizzard_char_id';
    id.value = String(raider.blizzardCharId);
    const select = document.createElement('select');
    select.name = 'role';
    select.className = 'role-select';
    select.setAttribute('aria-label', `Role for ${raider.name}`);
    const options: Array<[string, string]> = [
      ['', `Auto (${ROLE_LABELS[raider.autoRole]})`],
      ['dps', 'DPS'],
      ['healer', 'Healer'],
      ['tank', 'Tank'],
    ];
    for (const [value, label] of options) {
      const option = document.createElement('option');
      option.value = value;
      option.textContent = label;
      option.selected = (raider.roleOverride ?? '') === value;
      select.append(option);
    }
    select.addEventListener('change', () => form.requestSubmit());
    form.append(id, select);
    td.append(form);
    return td;
  }

  function unscoredReason(raider: Raider): string {
    const reasons: string[] = [];
    if (raider.fightsPresent < data.minimumPulls || raider.reportCount < data.minimumReports) {
      reasons.push(`Under ${data.minimumPulls} pulls / ${data.minimumReports} reports`);
    }
    if (raider.parseStatus === 'pending') reasons.push('Parse not fetched yet');
    else if (raider.parseStatus === 'not-found') reasons.push('Not found on Warcraft Logs');
    else if (raider.parseStatus === 'no-role-parse') reasons.push(`No ${data.difficultyLabel} ${ROLE_LABELS[raider.role]} parse`);
    return reasons.join(' · ');
  }

  function render(): void {
    const settings = currentSettings();
    saveSettings(settings);
    const parseWeight = settings.weight / 100;
    const deathWeight = 1 - parseWeight;

    weightLabel.value = `Parse ${settings.weight}% · Deaths ${100 - settings.weight}%`;
    weightInput.setAttribute('aria-valuetext', weightLabel.value);
    formula.textContent =
      settings.scale === 'raw'
        ? `Combined = ${parseWeight.toFixed(2)} × median parse + ${deathWeight.toFixed(2)} × death percentile. Raw parses spread less than death percentiles, so deaths count for more than the slider shows.`
        : `Combined = ${parseWeight.toFixed(2)} × parse percentile + ${deathWeight.toFixed(2)} × death percentile. Both are ranked within the guild (0–100), so the slider is the real split.`;

    const inRole = (raider: Raider) => settings.role === 'all' || raider.role === settings.role;

    const rows = scored
      .map((raider) => {
        const parse = raider.parse ?? 0;
        const parseScore = settings.scale === 'raw' ? parse : 100 * percentRank(parsePool, parse);
        const deathPct = 100 * (1 - percentRank(deathPool, raider.weightedScore));
        return { raider, parseScore, deathPct, combined: parseWeight * parseScore + deathWeight * deathPct };
      })
      .filter((row) => inRole(row.raider))
      .sort((a, b) => a.combined - b.combined || a.deathPct - b.deathPct || a.raider.name.localeCompare(b.raider.name));

    rankedBody.replaceChildren(
      ...rows.map((row, index) => {
        const tr = document.createElement('tr');
        tr.append(
          cell(String(index + 1), 'rank'),
          raiderCell(row.raider),
          roleCell(row.raider),
          cell((row.raider.parse ?? 0).toFixed(1), 'num'),
          cell(row.parseScore.toFixed(1), 'num'),
          cell(row.raider.weightedScore.toFixed(2), 'num'),
          cell(row.deathPct.toFixed(1), 'num'),
          cell(row.combined.toFixed(1), 'num combined')
        );
        return tr;
      })
    );
    document.getElementById('bench-ranked-empty')!.hidden = rows.length > 0;

    const unscoredRows = unscored.filter(inRole);
    unscoredBody.replaceChildren(
      ...unscoredRows.map((raider) => {
        const tr = document.createElement('tr');
        tr.append(
          raiderCell(raider),
          roleCell(raider),
          cell(raider.parse === null ? '—' : raider.parse.toFixed(1), 'num'),
          cell(String(raider.parseBosses), 'num'),
          cell(String(raider.fightsPresent), 'num'),
          cell(String(raider.reportCount), 'num'),
          cell(unscoredReason(raider), 'reason')
        );
        return tr;
      })
    );
    document.getElementById('bench-unscored-empty')!.hidden = unscoredRows.length > 0;
  }

  const initial = readSettings();
  weightInput.value = String(initial.weight);
  for (const [name, value] of [['bench-scale', initial.scale], ['bench-role', initial.role]] as const) {
    const input = document.querySelector(`input[name="${name}"][value="${value}"]`) as HTMLInputElement | null;
    if (input) input.checked = true;
  }

  weightInput.addEventListener('input', render);
  for (const input of document.querySelectorAll('input[name="bench-scale"], input[name="bench-role"]')) {
    input.addEventListener('change', render);
  }
  render();
</script>

<style>
  .bench-page {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .page-desc {
    margin: 0.35rem 0 0;
    color: #c7c2b8;
    max-width: 70ch;
  }

  .page-meta {
    margin: 0.4rem 0 0;
    color: #aea99f;
    font-size: 0.85rem;
  }

  .header-actions {
    flex-shrink: 0;
  }

  .action-btn {
    border: 1px solid rgba(214, 176, 106, 0.55);
    border-radius: 0.45rem;
    background: rgba(214, 176, 106, 0.12);
    color: #f3e2be;
    padding: 0.45rem 0.8rem;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 160ms ease, background 160ms ease;
    white-space: nowrap;
  }

  .action-btn:hover,
  .action-btn:focus-visible {
    border-color: rgba(214, 176, 106, 0.8);
    background: rgba(214, 176, 106, 0.2);
  }

  .admin-section {
    border: 1px solid rgba(214, 176, 106, 0.2);
    border-radius: 0.7rem;
    padding: 1rem;
    background: rgba(11, 7, 2, 0.45);
  }

  .admin-section h2 {
    margin: 0;
    color: #f2dfb5;
    font-size: 1.15rem;
  }

  .section-copy {
    margin: 0.25rem 0 0.75rem;
    color: #c7c2b8;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: flex-start;
  }

  .control {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .weight-control {
    flex: 1 1 18rem;
  }

  .control-label {
    padding: 0;
    color: #f2dfb5;
    font-weight: 700;
    font-size: 0.9rem;
  }

  .slider-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .slider-row input[type='range'] {
    flex: 1;
    min-width: 0;
    accent-color: #d6b06a;
  }

  .slider-end {
    color: #aea99f;
    font-size: 0.85rem;
  }

  .weight-readout {
    color: #f7efe0;
    font-variant-numeric: tabular-nums;
  }

  .segmented {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .segmented label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid rgba(214, 176, 106, 0.3);
    border-radius: 0.45rem;
    padding: 0.3rem 0.6rem;
    color: #e8dcc4;
    font-size: 0.88rem;
    cursor: pointer;
  }

  .segmented label:has(input:checked) {
    border-color: rgba(214, 176, 106, 0.8);
    background: rgba(214, 176, 106, 0.18);
    color: #fff3da;
  }

  .segmented input {
    accent-color: #d6b06a;
    margin: 0;
  }

  .formula {
    flex-basis: 100%;
    margin: 0;
    color: #aea99f;
    font-size: 0.85rem;
  }

  .table-wrap {
    overflow-x: auto;
  }

  .review-table {
    width: 100%;
    border-collapse: collapse;
  }

  .review-table th,
  .review-table :global(td) {
    padding: 0.55rem 0.55rem;
    border-bottom: 1px solid rgba(214, 176, 106, 0.15);
    vertical-align: middle;
  }

  .review-table th {
    text-align: left;
    color: #f2dfb5;
    font-weight: 700;
    white-space: nowrap;
  }

  .review-table th.num,
  .review-table :global(td.num) {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .review-table :global(td.rank) {
    color: #aea99f;
    font-variant-numeric: tabular-nums;
  }

  .review-table :global(td.combined) {
    color: #f7efe0;
    font-weight: 700;
  }

  .review-table :global(td.reason) {
    color: #aea99f;
    font-size: 0.85rem;
  }

  .review-table :global(.cell-stack) {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .review-table :global(.cell-stack small) {
    color: #aea99f;
    font-size: 0.8rem;
  }

  .review-table :global(.role-select) {
    border: 1px solid rgba(214, 176, 106, 0.3);
    border-radius: 0.45rem;
    background: rgba(12, 8, 2, 0.75);
    color: #f7efe0;
    padding: 0.3rem 0.4rem;
  }

  .empty-state {
    margin: 0.75rem 0 0;
    color: #aea99f;
  }

  .flash {
    border-radius: 0.6rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid transparent;
  }

  .flash-ok {
    background: rgba(36, 86, 42, 0.25);
    border-color: rgba(102, 191, 114, 0.55);
    color: #d5f2da;
  }

  .flash-error {
    background: rgba(101, 28, 28, 0.24);
    border-color: rgba(212, 82, 82, 0.55);
    color: #ffd6d6;
  }
</style>
