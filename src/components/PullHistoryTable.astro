---
import { recencyWeight } from '../lib/death-analysis';
import type { PullHistoryEntry } from '../lib/pull-scores';

interface Props {
  history: PullHistoryEntry[];
}

const { history } = Astro.props;
const nowUtc = Math.floor(Date.now() / 1000);

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  timeZone: 'America/New_York',
  weekday: 'short',
  month: 'short',
  day: 'numeric',
});
---

{history.length === 0 ? (
  <p class="empty-state">No scored pulls yet.</p>
) : (
  <div class="table-wrap">
    <table class="data-table data-table--compact pull-history-table">
      <colgroup>
        <col class="col-date" />
        <col class="col-boss" />
        <col class="col-result" />
        <col class="col-amount" />
        <col class="col-median" />
        <col class="col-score" />
        <col class="col-weight" />
        <col class="col-log" />
      </colgroup>
      <thead>
        <tr>
          <th>Date</th>
          <th>Boss</th>
          <th>Result</th>
          <th class="num">DPS/HPS</th>
          <th class="num">Role Median</th>
          <th class="num">Parse</th>
          <th class="num">Weight</th>
          <th>Log</th>
        </tr>
      </thead>
      <tbody>
        {history.map((pull) => (
          <tr>
            <td>{dateFormatter.format(new Date(pull.fightEndUtc * 1000))}</td>
            <td>{pull.encounterName}</td>
            <td>{pull.isKill ? 'Kill' : `Wipe (${pull.bossPercent.toFixed(1)}%)`}</td>
            <td class="num">{pull.amount.toFixed(0)}</td>
            <td class="num">{pull.roleMedian.toFixed(0)}</td>
            <td class="num">{pull.pullScore === null ? '—' : pull.pullScore.toFixed(1)}</td>
            <td class="num">{recencyWeight(pull.fightEndUtc, nowUtc).toFixed(2)}</td>
            <td>
              <a href={pull.wclLink} target="_blank" rel="noopener noreferrer">WCL</a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}

<style>
  .pull-history-table {
    table-layout: fixed;
  }

  .pull-history-table .col-date { width: 12%; }
  .pull-history-table .col-boss { width: 16%; }
  .pull-history-table .col-result { width: 15%; }
  .pull-history-table .col-amount { width: 11%; }
  .pull-history-table .col-median { width: 12%; }
  .pull-history-table .col-score { width: 12%; }
  .pull-history-table .col-weight { width: 10%; }
  .pull-history-table .col-log { width: 12%; }

  .pull-history-table th.num,
  .pull-history-table td.num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
</style>
