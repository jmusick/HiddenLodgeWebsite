---
interface ListedPull {
  reportCode: string;
  fightId: number;
  fightEndUtc: number;
  isKill: boolean;
}
interface Props { pulls: ListedPull[] }
const { pulls } = Astro.props;
const date = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
---

<section class="card pull-section" id="group-size-pulls">
  <div class="pull-heading">
    <div>
      <h2>Heroic Ula’tek pulls</h2>
      <p>Canonical guild logs from the last 90 days. Select a pull to load boss-only damage; results are cached for later visits.</p>
    </div>
    {pulls.length > 0 && <button class="btn btn--secondary" type="button" id="analyze-all-pulls">Analyze all pulls</button>}
  </div>
  {pulls.length === 0 ? <p class="empty-state">No synced Heroic Ula’tek pulls yet.</p> : (
    <>
      <p id="pull-load-status" class="load-status" aria-live="polite"></p>
      <div id="pull-detail" class="pull-detail" hidden></div>
      <div class="table-wrap">
        <table class="data-table data-table--compact">
          <thead><tr><th scope="col">Pull</th><th scope="col">Ended (ET)</th><th scope="col">Result</th><th scope="col">Players</th><th scope="col"><button type="button" class="column-help" data-column-tooltip="WCL does not provide maximum boss HP directly. Estimate = damage to Ula’tek, Venomous Heart, and Gore Rattle ÷ (1 − WCL boss remaining %). Pulls with 5% or less progress have no reliable estimate." aria-label="Boss HP estimate: how it is calculated">Boss HP est.</button></th><th scope="col">Boss left</th><th scope="col"><button type="button" class="column-help" data-column-tooltip="The pull’s damage compared with the damage needed to kill by the 10:00 enrage, after allowing for Heart burns and downtime. 100% or more is on pace; below 100% shows the boss health projected to remain at 10:00." aria-label="Pace vs. enrage: how it is calculated">Pace vs. enrage</button></th><th scope="col">DPS meeting target</th></tr></thead>
          <tbody>
            {pulls.map((pull) => (
              <tr data-report={pull.reportCode} data-fight={pull.fightId}>
                <td><button class="pull-link" type="button" data-select-pull>{pull.reportCode.slice(0, 4)} · #{pull.fightId}</button></td>
                <td>{date.format(new Date(pull.fightEndUtc * 1000))}</td>
                <td>{pull.isKill ? 'Kill' : 'Wipe'}</td>
                <td data-players>—</td>
                <td data-health>—</td>
                <td data-boss-left>Load pull</td>
                <td data-pace>Load pull</td>
                <td data-members>—</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}
</section>

<script>
  import type { PullAnalysis } from '../lib/group-size-pulls';

  const section = document.querySelector<HTMLElement>('#group-size-pulls');
  if (section) {
    const rows = [...section.querySelectorAll<HTMLTableRowElement>('tr[data-report][data-fight]')];
    const detail = section.querySelector<HTMLElement>('#pull-detail');
    const status = section.querySelector<HTMLElement>('#pull-load-status');
    const allButton = section.querySelector<HTMLButtonElement>('#analyze-all-pulls');
    const cache = new Map<string, PullAnalysis>();
    const pending = new Map<string, Promise<PullAnalysis>>();
    const int = (value: number) => Math.ceil(value).toLocaleString('en-US');
    const decimal = (value: number) => value.toLocaleString('en-US', { maximumFractionDigits: 1 });
    const percent = (ratio: number) => `${Math.round(ratio * 100)}%`;
    const compact = (value: number) => value.toLocaleString('en-US', { notation: 'compact', maximumFractionDigits: value >= 1e6 ? 2 : 0 });
    // Kept across pulls so switching pulls doesn't reset the member table view.
    let memberView: 'overall' | 'stage' = 'overall';
    const clock = (seconds: number) => `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, '0')}`;
    const key = (row: HTMLTableRowElement) => `${row.dataset.report}:${row.dataset.fight}`;
    const node = <K extends keyof HTMLElementTagNameMap>(tag: K, className = '', content = ''): HTMLElementTagNameMap[K] => {
      const item = document.createElement(tag);
      item.className = className;
      item.textContent = content;
      return item;
    };

    // Match the hover and keyboard column tooltips used by Parse Analysis.
    const helpButtons = [...section.querySelectorAll<HTMLButtonElement>('.column-help')];
    const tooltip = node('div', 'group-size-column-tooltip');
    tooltip.id = 'group-size-column-tooltip';
    tooltip.role = 'tooltip';
    tooltip.hidden = true;
    if (helpButtons.length > 0) document.body.append(tooltip);
    for (const helpButton of helpButtons) {
      const hideTooltip = () => { tooltip.hidden = true; helpButton.setAttribute('aria-expanded', 'false'); };
      const showTooltip = () => {
        tooltip.textContent = helpButton.dataset.columnTooltip ?? '';
        tooltip.hidden = false;
        helpButton.setAttribute('aria-describedby', tooltip.id);
        helpButton.setAttribute('aria-expanded', 'true');
        const rect = helpButton.getBoundingClientRect();
        const tip = tooltip.getBoundingClientRect();
        tooltip.style.left = `${Math.max(10, Math.min(rect.left, window.innerWidth - tip.width - 10))}px`;
        tooltip.style.top = `${rect.bottom + tip.height + 10 <= window.innerHeight ? rect.bottom + 8 : Math.max(10, rect.top - tip.height - 8)}px`;
      };
      helpButton.setAttribute('aria-expanded', 'false');
      helpButton.addEventListener('mouseenter', showTooltip);
      helpButton.addEventListener('focus', showTooltip);
      helpButton.addEventListener('mouseleave', hideTooltip);
      helpButton.addEventListener('blur', hideTooltip);
      helpButton.addEventListener('click', showTooltip);
    }

    async function load(row: HTMLTableRowElement): Promise<PullAnalysis> {
      const id = key(row);
      const existing = cache.get(id);
      if (existing) return existing;
      const inFlight = pending.get(id);
      if (inFlight) return inFlight;
      const cell = row.querySelector<HTMLElement>('[data-pace]')!;
      cell.textContent = 'Loading…';
      const task = (async () => {
        const params = new URLSearchParams({ report: row.dataset.report!, fight: row.dataset.fight! });
        const response = await fetch(`/api/group-size-analysis/pull?${params}`);
        if (!response.ok) throw new Error((await response.text()) || 'Could not load pull');
        const result = await response.json() as PullAnalysis;
        cache.set(id, result);
        cell.textContent = result.isKill
          ? `Killed in ${clock(result.durationSeconds)}`
          : result.paceRatio === null ? 'No pace estimate'
          : result.projectedKillSeconds !== null ? `${percent(result.paceRatio)} · kill ~${clock(result.projectedKillSeconds)}`
          : `${percent(result.paceRatio)} · ${decimal(result.projectedRemainingPercent ?? 0)}% left at 10:00`;
        row.querySelector<HTMLElement>('[data-boss-left]')!.textContent = `${decimal(result.bossRemainingPercent)}%`;
        row.querySelector<HTMLElement>('[data-players]')!.textContent = String(result.groupSize);
        row.querySelector<HTMLElement>('[data-health]')!.textContent = result.inferredBossHealth === null ? 'Unavailable' : int(result.inferredBossHealth);
        row.querySelector<HTMLElement>('[data-members]')!.textContent = result.playersWithMinimum === null ? 'No target' : `${result.playersWithMinimum}/${result.damageDealers} DPS`;
        return result;
      })();
      pending.set(id, task);
      try { return await task; } catch (error) {
        cell.textContent = 'Retry';
        throw error;
      } finally { pending.delete(id); }
    }

    function render(result: PullAnalysis) {
      if (!detail) return;
      detail.replaceChildren();
      detail.hidden = false;
      const heading = node('div', 'detail-heading');
      heading.append(node('h3', '', `Pull #${result.fightId} · ${result.isKill ? 'Kill' : 'Wipe'}`));
      const link = node('a', '', 'Open in Warcraft Logs ↗');
      link.href = `https://www.warcraftlogs.com/reports/${result.reportCode}#fight=${result.fightId}&type=damage-done`;
      link.target = '_blank'; link.rel = 'noopener noreferrer'; heading.append(link);
      detail.append(heading);
      const summary = node('div', 'pull-summary');
      const facts: Array<[string, string]> = [
        ['Pull length', clock(result.durationSeconds)],
        ['Players', `${result.groupSize} (${result.tanks} tanks · ${result.healers} healers · ${result.damageDealers} DPS)`],
        ['Boss HP estimate', result.inferredBossHealth === null ? 'Unavailable' : int(result.inferredBossHealth)],
        ['Boss left', `${decimal(result.bossRemainingPercent)}%`],
        ['Boss damage', int(result.raidBossDamage)],
        ['Raid pace', result.requiredPaceDps === null ? `${int(result.paceDps)} (no target)` : `${int(result.paceDps)} of ${int(result.requiredPaceDps)} needed`],
        ['DPS player target', result.requiredPaceDpsPerDamageDealer === null ? 'Unavailable' : `${int(result.requiredPaceDpsPerDamageDealer)} pace DPS`],
        ['Pace vs. enrage', result.paceRatio === null ? 'Unavailable' : percent(result.paceRatio)],
      ];
      for (const [label, value] of facts) {
        const item = node('div', 'summary-fact');
        item.append(node('span', 'label', label), node('strong', '', value));
        summary.append(item);
      }
      detail.append(summary);
      if (result.inferredBossHealth === null) detail.append(node('p', 'caveat', 'This pull lost 5% or less boss health, so its remaining-health percentage cannot support a useful HP or DPS target estimate.'));
      const onPace = result.paceRatio !== null && result.paceRatio >= 1;
      const verdict = result.isKill
        ? `Kill at ${clock(result.durationSeconds)} — ${clock(Math.abs(result.durationSeconds - 600))} ${result.durationSeconds <= 600 ? 'before' : 'after'} the 10:00 enrage.`
        : result.paceRatio === null ? 'No 10:00 projection is available without an estimated starting HP.'
        : result.durationSeconds >= 600 ? `This pull reached the 10:00 enrage with ${decimal(result.bossRemainingPercent)}% boss health left, at ${percent(result.paceRatio)} of the pace needed.`
        : result.projectedKillSeconds !== null ? `On pace: ${percent(result.paceRatio)} of the pace needed. Continuing through the remaining stages and Heart burns at this pace projects a kill at ${clock(result.projectedKillSeconds)}.`
        : `Behind pace: ${percent(result.paceRatio)} of the pace needed. Continuing through the remaining stages and Heart burns at this pace leaves ${decimal(result.projectedRemainingPercent ?? 0)}% boss health at the 10:00 enrage.`;
      detail.append(node('p', result.isKill || onPace ? 'verdict good' : 'verdict', verdict));
      if (!result.isKill && result.durationSeconds < 600) detail.append(node('p', 'caveat', 'Stages this pull did not reach are projected from the guild’s typical damage in each stage. Deaths, cooldown timing, and a stronger or weaker Heart burn can move the result.'));

      detail.append(node('h4', '', 'Boss damage by stage'));
      const stageWrap = node('div', 'table-wrap');
      const stageTable = node('table', 'data-table data-table--compact member-table stage-table');
      const stageHead = node('thead');
      const stageHeaderRow = node('tr');
      for (const title of ['Stage', 'Time', 'Typical weight', 'Time played', 'Boss damage', 'Needed for 10:00 kill']) stageHeaderRow.append(node('th', '', title));
      stageHead.append(stageHeaderRow); stageTable.append(stageHead);
      const stageBody = node('tbody');
      for (const segment of result.segments) {
        const tr = node('tr');
        const cells = [segment.label, `${clock(segment.start)}–${clock(segment.end)}`, `${segment.weight.toLocaleString('en-US', { maximumFractionDigits: 2 })}×`,
          segment.elapsedSeconds > 0 ? `${decimal(segment.elapsedSeconds)}s` : 'Not reached',
          segment.elapsedSeconds > 0 ? int(segment.damage) : '—',
          segment.requiredDamage === null ? '—' : int(segment.requiredDamage)];
        cells.forEach((value, index) => tr.append(node('td', index >= 2 ? 'number-cell' : '', value)));
        stageBody.append(tr);
      }
      stageTable.append(stageBody); stageWrap.append(stageTable); detail.append(stageWrap);
      detail.append(node('p', 'caveat table-note', 'Typical weight is the guild’s median raid boss DPS in that stage relative to Stage 1. “Needed” splits the boss’s health across the full fight at the required pace; a partly played stage shows its damage so far against the full-stage need.'));

      const memberHeading = node('div', 'member-heading');
      memberHeading.append(node('h4', '', 'Member boss damage'));
      const viewToggle = node('div', 'view-toggle');
      viewToggle.role = 'group';
      viewToggle.setAttribute('aria-label', 'Member table view');
      memberHeading.append(viewToggle);
      detail.append(memberHeading);
      const wrap = node('div', 'table-wrap');
      const stageNote = node('p', 'caveat table-note', 'Each cell is the raider’s boss DPS over the part of that stage the pull reached. A DPS player’s stage target is their pace target × the stage’s typical weight, so hitting every stage target adds up to the overall pace target.');
      detail.append(wrap, stageNote);
      const roleOrder = { tank: 0, healer: 1, dps: 2 };
      const sortedPlayers = [...result.players].sort((a, b) => roleOrder[a.role] - roleOrder[b.role] || b.bossDps - a.bossDps);
      const roleLabel = (role: string) => role === 'dps' ? 'DPS' : role === 'tank' ? 'Tank' : 'Healer';
      const reachedStages = result.segments.map((segment, index) => ({ segment, index })).filter(({ segment }) => segment.elapsedSeconds >= 1);

      const renderMembers = () => {
        const byStage = memberView === 'stage';
        const table = node('table', `data-table data-table--compact member-table${byStage ? ' member-table--stages' : ''}`);
        const head = node('thead');
        const headerRow = node('tr');
        const titles = byStage ? ['Raider', 'Role', ...reachedStages.map(({ segment }) => segment.label)]
          : ['Raider', 'Role', 'Boss damage', 'Boss DPS', 'Pace DPS', 'Pace target', 'Result'];
        for (const title of titles) headerRow.append(node('th', '', title));
        head.append(headerRow); table.append(head);
        const body = node('tbody');
        for (const player of sortedPlayers) {
          const tr = node('tr');
          tr.append(node('td', '', player.name), node('td', '', roleLabel(player.role)));
          if (byStage) {
            for (const { index } of reachedStages) {
              const stage = player.stages[index];
              const cell = node('td', `number-cell stage-cell${stage.meetsTarget === null ? '' : stage.meetsTarget ? ' stage-cell--meets' : ' stage-cell--below'}`);
              cell.append(node('span', 'stage-dps', compact(stage.dps ?? 0)));
              if (stage.target !== null) cell.append(node('span', 'stage-target', `of ${compact(stage.target)}`));
              tr.append(cell);
            }
          } else {
            const cells = [int(player.bossDamage), int(player.bossDps), int(player.paceDps),
              player.role === 'dps' && result.requiredPaceDpsPerDamageDealer !== null ? int(result.requiredPaceDpsPerDamageDealer) : '—'];
            cells.forEach((value) => tr.append(node('td', 'number-cell', value)));
            const resultCell = node('td');
            const statusClass = player.role === 'dps' && player.meetsMinimum === null ? 'unavailable' : player.meetsMinimum === null ? 'contribution' : player.meetsMinimum ? 'meets' : 'below';
            const statusLabel = player.role === 'dps' && player.meetsMinimum === null ? 'No target' : player.meetsMinimum === null ? 'Contribution' : player.meetsMinimum ? 'Meets target' : 'Below target';
            resultCell.append(node('span', `result-badge result-badge--${statusClass}`, statusLabel));
            tr.append(resultCell);
          }
          body.append(tr);
        }
        table.append(body);
        wrap.replaceChildren(table);
        stageNote.hidden = !byStage;
        viewToggle.querySelectorAll<HTMLButtonElement>('button').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.view === memberView)));
      };
      for (const [view, label] of [['overall', 'Overall'], ['stage', 'By stage']] as const) {
        const button = node('button', 'view-toggle-button', label);
        button.type = 'button';
        button.dataset.view = view;
        button.addEventListener('click', () => { memberView = view; renderMembers(); });
        viewToggle.append(button);
      }
      renderMembers();

      const math = node('details', 'math-detail');
      math.append(node('summary', '', 'Show all math and formulas'));
      const list = node('ol');
      const offset = Math.abs(result.timelineOffsetSeconds) >= 0.5
        ? ` This pull’s first Heart burn started ${decimal(Math.abs(result.timelineOffsetSeconds))}s ${result.timelineOffsetSeconds > 0 ? 'late' : 'early'}, so its stage times are shifted to match.` : '';
      const remaining = result.inferredBossHealth === null ? 0 : result.inferredBossHealth - result.raidBossDamage;
      const formulas = [
        `WCL shared-health target damage = Ula’tek + Venomous Heart + Gore Rattle = ${int(result.raidBossDamage)}. WCL boss remaining = ${decimal(result.bossRemainingPercent)}%.`,
        result.inferredBossHealth === null ? 'Starting HP is unavailable because the pull lost 5% or less boss health.' : `Inferred starting health = ${int(result.raidBossDamage)} ÷ (1 − ${result.bossRemainingPercent}% / 100) = ${int(result.inferredBossHealth)}. WCL does not provide maximum boss HP directly.`,
        `The fight runs on a fixed clock: Heart burns at 2:15, 4:44 and 9:33 (20s each), a Stage 2 add phase and an intermission where the boss takes almost no damage, and the enrage at 10:00. Each stage’s typical weight is the guild’s median raid boss DPS there relative to Stage 1 (see the stage table).${offset}`,
        `Weighted seconds = Σ (seconds played in each stage × its weight). This pull: ${decimal(result.weightedSecondsElapsed)} weighted seconds in ${decimal(result.durationSeconds)}s. A full fight to 10:00: ${decimal(result.weightedSecondsToDeadline)} weighted seconds.`,
        `Raid pace = boss damage ÷ weighted seconds so far = ${int(result.raidBossDamage)} ÷ ${decimal(result.weightedSecondsElapsed)} = ${int(result.paceDps)} DPS, in Stage 1 terms. Heart burns and downtime no longer inflate or deflate it.`,
        result.requiredPaceDps === null ? 'Required pace is unavailable without starting HP.' : `Required pace = starting health ÷ full-fight weighted seconds = ${int(result.inferredBossHealth ?? 0)} ÷ ${decimal(result.weightedSecondsToDeadline)} = ${int(result.requiredPaceDps)} DPS. Pace vs. enrage = ${int(result.paceDps)} ÷ ${int(result.requiredPaceDps)} = ${percent(result.paceRatio ?? 0)}.`,
        result.isKill || result.inferredBossHealth === null ? 'No projection is needed for a kill or possible without starting HP.'
          : result.durationSeconds >= 600 ? 'This pull reached the enrage, so its actual boss health left is used instead of a projection.'
          : `Projection: the remaining ${int(remaining)} boss health is dealt stage by stage from ${clock(result.durationSeconds)} at raid pace × each stage’s weight. ${result.projectedKillSeconds !== null ? `It runs out at ${clock(result.projectedKillSeconds)}.` : `By 10:00 that deals ${int(result.paceDps * (result.weightedSecondsToDeadline - result.weightedSecondsElapsed))}, leaving ${decimal(result.projectedRemainingPercent ?? 0)}%.`}`,
        `Tank and healer pace = their combined target damage ÷ ${decimal(result.weightedSecondsElapsed)} weighted seconds = ${int(result.rolePaceDps)} DPS. Per-DPS-player target = max(0, (required pace − tank and healer pace) ÷ ${result.damageDealers}) = ${result.requiredPaceDpsPerDamageDealer === null ? 'unavailable' : `${int(result.requiredPaceDpsPerDamageDealer)} pace DPS`}.`,
        'Each player’s boss DPS = their damage to the three shared-health targets ÷ full pull length. Their pace DPS = the same damage ÷ the pull’s weighted seconds, so it can be compared with the target however far the pull got. A DPS player meets the target when their pace DPS is at least the per-DPS-player target. Tank and healer rows show contributions without a pass/fail label.',
        `By stage: a raider’s stage DPS = their target damage in that stage ÷ the seconds of it the pull reached. A DPS player’s stage target = per-DPS-player target × the stage’s weight${result.requiredPaceDpsPerDamageDealer === null ? '' : ` (for example Stage 1 ${int(result.requiredPaceDpsPerDamageDealer)}, Heart burn 1 ${int(result.requiredPaceDpsPerDamageDealer * (result.segments[1]?.weight ?? 0))})`}. Meeting every stage target is the same as meeting the overall pace target; the overall result can still pass with a weak stage made up elsewhere.`,
      ];
      formulas.forEach((formula) => list.append(node('li', '', formula)));
      math.append(list); detail.append(math);
    }

    rows.forEach((row) => row.querySelector('[data-select-pull]')?.addEventListener('click', async () => {
      rows.forEach((other) => other.classList.toggle('selected-row', other === row));
      if (status) status.textContent = 'Loading pull…';
      try { render(await load(row)); if (status) status.textContent = ''; detail?.scrollIntoView({ block: 'start', behavior: 'smooth' }); }
      catch (error) { if (status) status.textContent = error instanceof Error ? error.message : 'Could not load pull'; }
    }));
    allButton?.addEventListener('click', async () => {
      allButton.disabled = true;
      let done = 0;
      let failed = 0;
      // Bound WCL requests: each uncached pull makes two GraphQL calls.
      const queue = [...rows];
      await Promise.all(Array.from({ length: 2 }, async () => {
        while (queue.length > 0) {
          const row = queue.shift()!;
          try { await load(row); } catch { failed++; }
          done++;
          if (status) status.textContent = `Analyzed ${done}/${rows.length} pulls${failed ? ` · ${failed} could not load` : ''}`;
        }
      }));
      allButton.disabled = false;
    });
    if (rows[0]) {
      // Load the newest pull without moving the reader's initial scroll position.
      load(rows[0]).then((result) => { rows[0].classList.add('selected-row'); render(result); })
        .catch((error) => { if (status) status.textContent = error instanceof Error ? error.message : 'Could not load pull'; });
    }
  }
</script>

<style>
  .pull-section { min-width: 0; }
  .pull-heading { display: flex; justify-content: space-between; align-items: start; gap: var(--space-4); flex-wrap: wrap; }
  h2, h3, h4 { margin: 0 0 var(--space-3); }
  .pull-heading p, .load-status, .caveat { color: var(--muted); margin: 0 0 var(--space-4); }
  .pull-link { border: 0; padding: 0; color: var(--gold-bright); background: transparent; font: inherit; cursor: pointer; text-decoration: underline; }
  .pull-section :global(.data-table) { --table-min: 900px; }
  .pull-section :global(.selected-row) { background: var(--surface-active); }
  .column-help { display: inline; padding: 0; border: 0; background: none; color: inherit; font: inherit; text-align: inherit; text-decoration: underline dotted var(--gold-bright); text-underline-offset: 0.25em; cursor: help; }
  .column-help:hover, .column-help:focus-visible { color: var(--gold-bright); }
  :global(.group-size-column-tooltip) { position: fixed; z-index: 50; box-sizing: border-box; width: min(21rem, calc(100vw - 1.25rem)); padding: var(--space-4) var(--space-5); border: 1px solid var(--gold-bright); border-radius: var(--radius-md); background: var(--surface-raised); box-shadow: 0 12px 28px rgb(0 0 0 / 40%); color: var(--text); font-size: var(--text-sm); font-weight: 400; line-height: 1.45; pointer-events: none; }
  .pull-detail { margin: var(--space-5) 0 var(--space-7); border-top: 1px solid var(--border-soft); padding-top: var(--space-6); scroll-margin-top: var(--space-7); }
  .pull-detail :global(.detail-heading) { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-5); flex-wrap: wrap; margin-bottom: var(--space-5); }
  .pull-detail :global(.detail-heading h3) { margin: 0; }
  .pull-detail :global(.detail-heading a) { color: var(--gold-bright); }
  .pull-detail :global(.pull-summary) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); margin: 0 0 var(--space-6); }
  .pull-detail :global(.summary-fact) { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; padding: var(--space-5); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--surface-sunken); }
  .pull-detail :global(.summary-fact strong) { font-size: var(--text-lg); line-height: 1.3; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .pull-detail :global(.caveat) { color: var(--muted); line-height: 1.5; margin: 0 0 var(--space-5); }
  .pull-detail :global(.verdict) { padding: var(--space-5) var(--space-6); margin: 0 0 var(--space-5); border: 1px solid var(--border-soft); border-left: 3px solid var(--warning); border-radius: var(--radius-md); background: var(--surface-sunken); line-height: 1.5; }
  .pull-detail :global(.verdict.good) { border-left-color: var(--success); }
  .pull-detail :global(h4) { margin: var(--space-7) 0 var(--space-4); }
  .pull-detail :global(.member-table) { --table-min: 750px; }
  .pull-detail :global(.member-table th), .pull-detail :global(.member-table td) { padding: var(--space-4) var(--space-5); }
  .pull-detail :global(.member-table tbody tr:nth-child(even)) { background: var(--surface-zebra); }
  .pull-detail :global(.member-table th:nth-child(n+3):nth-child(-n+6)), .pull-detail :global(.member-table .number-cell) { text-align: right; font-variant-numeric: tabular-nums; }
